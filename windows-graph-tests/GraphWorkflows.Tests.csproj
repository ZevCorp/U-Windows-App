<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pruebas de la lógica de decisión del ejecutor de exportaciones.

    Qué cubre y qué NO: aquí solo entra lo que decide SIN tocar nada — clasificar la señal de SAP,
    revisar un trabajo antes de ejecutarlo, y el diario que sobrevive a los reinicios. Es a propósito:
    esas tres piezas se escribieron sin dependencias de COM, de red ni de la interfaz precisamente
    para que el camino «SAP dijo X → se reporta Y» se pueda probar entero sin SAP, sin Graph y sin un
    equipo del hospital. Lo que sí toca COM (SapGuiSurface, WorkflowPlayer) no se prueba aquí y
    requiere el entorno real; está anotado en docs/pruebas-exportacion.md.

    El TFM es net8.0-windows porque el proyecto bajo prueba lo es (UIA + WPF). Se ejecuta en Windows:

      cd windows-graph-tests
      dotnet test
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>U.Graph.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\windows-graph\GraphWorkflows.csproj" />
  </ItemGroup>

</Project>
