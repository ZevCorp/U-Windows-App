<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Ü arranca sola al iniciar sesión y se vuelve a abrir si se cae.
       Instalar:   cp com.zevcorp.u.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.zevcorp.u.plist
       Quitar:     launchctl unload ~/Library/LaunchAgents/com.zevcorp.u.plist && rm ~/Library/LaunchAgents/com.zevcorp.u.plist -->
  <key>Label</key>            <string>com.zevcorp.u</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/open</string>
    <string>/Users/isaabelsofia/visual ü/mac-client/U.app</string>
  </array>
  <!-- Con `open`, y no el binario suelto: lanzado a pelo, macOS lo mata por privacidad
       (__TCC_CRASHING_DUE_TO_PRIVACY_VIOLATION__) aunque el Info.plist tenga todos los permisos. -->
  <key>RunAtLoad</key>        <true/>
  <key>KeepAlive</key>        <false/>
  <key>StandardErrorPath</key><string>/tmp/u-arranque.log</string>
</dict>
</plist>
