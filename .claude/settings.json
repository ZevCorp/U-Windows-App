{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Users/Jose David Jaramillo/.local/bin/graphify.EXE\" hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Users/Jose David Jaramillo/.local/bin/graphify.EXE\" hook-guard read"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guardia-nucleo.ps1\"",
            "timeout": 300,
            "statusMessage": "Guardia del nucleo del grafo"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "PowerShell(Get-Process -Name U -ErrorAction SilentlyContinue)"
    ]
  }
}
