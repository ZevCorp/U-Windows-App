<Window x:Class="U.WindowsClient.Ui.FaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:U.WindowsClient.Ui"
        Title="Ü"
        Width="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize" SizeToContent="Height">

    <Window.Resources>
        <!-- Botón plano que HONRA su Background en todos los estados. WPF, con el template por defecto,
             pinta un fondo claro del sistema cuando el botón está deshabilitado y deja el Foreground
             blanco → texto blanco sobre fondo blanco. Este template lo arregla: deshabilitado = fondo
             tenue + texto atenuado, siempre legible. -->
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#18FFFFFF"/>
                                <Setter Property="Foreground" Value="#55FFFFFF"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Carita flotante: overlay permanente, arrastrable, siempre encima. Es TODO el frontend visible.
         No decide nada; solo muestra el estado y recoge lo que el usuario pide.
         Dos estados en la misma ventana: el panel completo, o SOLO la carita (se alternan con un clic
         en la carita). Ver FaceWindow.xaml.cs (ToggleCollapsed). -->
    <Grid>
        <!-- Estado COLAPSADO: solo la carita, como una burbuja flotante. Clic → panel · doble clic →
             micrófono · mantener oprimido → cambia de tema · arrastrar y soltar → se lanza al borde.
             El Margin de 28 deja aire alrededor para que la sombra (blur 24) no se recorte. -->
        <ui:FaceControl x:Name="CollapsedFace" Width="72" Height="72"
                        Visibility="Collapsed" Cursor="Hand"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="28"
                        ToolTip="Clic: abrir panel · doble clic: micrófono · mantener: cambiar tema · arrastrar y soltar: mover">
            <ui:FaceControl.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="Black"/>
            </ui:FaceControl.Effect>
        </ui:FaceControl>

        <!-- Estado EXPANDIDO: el panel completo de siempre. -->
        <Border x:Name="Panel" CornerRadius="18" Background="#F2101014" Padding="14"
                BorderBrush="#33FFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="Black"/>
            </Border.Effect>
            <StackPanel>
                <!-- Cabecera arrastrable: la carita + estado -->
                <DockPanel x:Name="Header" LastChildFill="True" Cursor="SizeAll">
                    <!-- La carita (misma que Android). Clic → colapsa a solo la carita · doble clic →
                         micrófono · mantener oprimido → cambia de tema · arrastrar → mover. -->
                    <ui:FaceControl x:Name="Face" Width="40" Height="40" DockPanel.Dock="Left" Cursor="Hand"
                                    ToolTip="Clic: solo la carita · doble clic: micrófono · mantener: cambiar tema · arrastrar: mover"/>
                    <TextBlock x:Name="Status" Text="Ü listo" Foreground="#EEFFFFFF" FontSize="13"
                               VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                </DockPanel>

                <!-- Globo de narración: crece con el texto (la ventana se expande hacia arriba) y,
                     si el texto excede el máximo, hace scroll en vez de cortarse. -->
                <ScrollViewer MaxHeight="380" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="Bubble" Text="" Foreground="#CCFFFFFF" FontSize="12"
                               TextWrapping="Wrap"/>
                </ScrollViewer>

                <!-- Pastilla de actualización: oculta salvo que ya haya una versión descargada y lista.
                     Si el usuario la ignora, se aplica sola al cerrar (ver Updater.ApplyOnExit). -->
                <Button x:Name="UpdateBtn" Content="⬇ Nueva versión lista — reiniciar" Height="28"
                        Margin="0,10,0,0" Click="OnApplyUpdate" Background="#553B82F6" Foreground="White"
                        BorderThickness="0" FontSize="11" Visibility="Collapsed"
                        ToolTip="Se instalará sola al cerrar Ü si prefieres seguir trabajando"/>

                <!-- Entrada de texto + micrófono -->
                <DockPanel Margin="0,12,0,0" LastChildFill="True">
                    <Button x:Name="MicBtn" Content="🎤" DockPanel.Dock="Right" Width="34" Height="30"
                            Margin="6,0,0,0" Click="OnMic" Background="#22FFFFFF" Foreground="White" BorderThickness="0"/>
                    <!-- Siempre visible: callarlo tiene que estar a un clic, sin importar qué esté pasando. -->
                    <Button x:Name="MuteBtn" Content="🔊" DockPanel.Dock="Right" Width="34" Height="30"
                            Margin="6,0,0,0" Click="OnToggleMute" Background="#22FFFFFF" Foreground="White"
                            BorderThickness="0" ToolTip="Callar a Ü ahora mismo"/>
                    <Button x:Name="StopBtn" Content="⏹" DockPanel.Dock="Right" Width="34" Height="30"
                            Margin="6,0,0,0" Click="OnStop" Background="#55FF3B30" Foreground="White" BorderThickness="0"
                            Visibility="Collapsed"/>
                    <TextBox x:Name="Input" Height="30" VerticalContentAlignment="Center"
                             Background="#22FFFFFF" Foreground="White" BorderThickness="0" Padding="8,0"
                             KeyDown="OnInputKey"/>
                </DockPanel>

                <!-- Enseñanza activa: graba pantalla+voz para que Ü aprenda a usar una app. -->
                <DockPanel Margin="0,8,0,0" LastChildFill="True">
                    <Button x:Name="VideosBtn" Content="🎞 Videos" DockPanel.Dock="Right" Width="76" Height="30"
                            Margin="6,0,0,0" Click="OnOpenVideos" Background="#22FFFFFF" Foreground="White"
                            BorderThickness="0" FontSize="11"/>
                    <!-- Solo visible mientras se graba: descarta lo grabado y vuelve a empezar, sin que el
                         error llegue nunca a Gemini ni al cerebro. Ver TeachSession.RestartAsync. -->
                    <Button x:Name="RestartTeachBtn" Content="🔄" DockPanel.Dock="Right" Width="34" Height="30"
                            Margin="6,0,0,0" Click="OnRestartTeach" Background="#22FFFFFF" Foreground="White"
                            BorderThickness="0" FontSize="11" Visibility="Collapsed"
                            ToolTip="Me equivoqué: descartar esta grabación y empezar de nuevo"/>
                    <Button x:Name="TeachBtn" Content="🎓 Enseñar" Height="30" Click="OnToggleTeach"
                            Background="#22FFFFFF" Foreground="White" BorderThickness="0" FontSize="11"/>
                </DockPanel>

                <!-- Ajustes mínimos: dónde vive el cerebro -->
                <Expander x:Name="BackendExpander" Header="Backend" Foreground="#88FFFFFF" FontSize="11"
                          Margin="0,10,0,0" Expanded="OnBackendExpanded">
                    <StackPanel Margin="0,6,0,0">
                        <!-- El backend ya no se configura a mano: la URL tiene default sano y la API key
                             llega sola (key embebida en el build de distribución, o env GRAPH_API_KEY en
                             dev). Esto es solo un estado de diagnóstico, no un campo editable. Ver
                             GraphConfig.Load y el doc "Distribución conectada" del Provider Studio. -->
                        <TextBlock x:Name="BackendStatus" Foreground="#88FFFFFF" FontSize="10"
                                   TextWrapping="Wrap" Margin="0,0,0,2"/>

                        <!-- Inspector visual de elementos (estilo TalkBack): dibuja recuadros sobre la
                             pantalla; al hacer clic, amarillo si coincide con lo que el asistente tocaría,
                             rojo doble si no. Ver UiInspector. -->
                        <Button x:Name="InspectorBtn" Content="🔍 Inspector de elementos" Height="26" Margin="0,10,0,0"
                                Click="OnToggleInspector" Background="#33FFFFFF" Foreground="White" BorderThickness="0"
                                ToolTip="Muestra recuadros sobre los elementos de la pantalla. Al hacer clic: amarillo si coincide con lo que el asistente tocaría, rojo (ambos) si no."/>

                        <!-- El "location bar de Windows": ID de superficie actual, arriba a la derecha.
                             Mismo formato que source_url de los workflows (uia:// y web://). -->
                        <Button x:Name="LocatorBtn" Content="📍 ID visible — clic para ocultar" Height="26" Margin="0,6,0,0"
                                Click="OnToggleLocator" Background="#33FFFFFF" Foreground="White" BorderThickness="0"
                                ToolTip="Muestra dónde estás parado como URL: uia://app.exe/ventana o web://dominio/ruta. Es el ID con el que se cargan los workflows."/>

                        <!-- Utilidades ocultas aquí para no saturar la fila principal: biblioteca de
                             workflows (ejecutar/autofill) y registro de diagnóstico. La grabación ya
                             la hace el botón 🎓 Enseñar (pasos UIA + video en un solo gesto). -->
                        <Button x:Name="WorkflowsBtn" Content="🧭 Workflows" Height="26" Margin="0,10,0,0"
                                Click="OnOpenWorkflows" Background="#33FFFFFF" Foreground="White" BorderThickness="0"
                                ToolTip="Biblioteca de workflows: ejecutar contra Graph (SAP GUI / UIA) + autofill"/>

                        <!-- Ejecutar un workflow directo, sin abrir la biblioteca. Dos formas de elegir el
                             workflow, alternables con el botón de la derecha: CARRUSEL (un título a la vez,
                             flechas ◀ ▶) o LISTA. El botón corre igual que "Ejecutar ahora" de la biblioteca
                             (WorkflowPlayer contra Graph, con alineación consciente si la pantalla no coincide). -->
                        <DockPanel Margin="0,10,0,3" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="Ejecutar workflow" Foreground="#88FFFFFF"
                                       FontSize="10" VerticalAlignment="Center"/>
                            <Button x:Name="WorkflowViewToggle" DockPanel.Dock="Right" Content="☰" Width="26" Height="20"
                                    Click="OnToggleWorkflowView" Style="{StaticResource FlatBtn}" Background="#22FFFFFF"
                                    Foreground="#CCFFFFFF" FontSize="11" ToolTip="Cambiar entre carrusel y lista"/>
                            <Button x:Name="WorkflowDeleteBtn" DockPanel.Dock="Right" Content="🗑" Width="26" Height="20"
                                    Margin="0,0,6,0" Click="OnDeleteWorkflow" Style="{StaticResource FlatBtn}"
                                    Background="#33FF3B30" Foreground="#EEFFFFFF" FontSize="11" IsEnabled="False"
                                    ToolTip="Borrar el workflow que se muestra (no se puede deshacer)"/>
                        </DockPanel>

                        <!-- Vista CARRUSEL: flecha ◀, título centrado, flecha ▶ -->
                        <DockPanel x:Name="WorkflowCarousel" LastChildFill="True">
                            <Button x:Name="WorkflowPrev" DockPanel.Dock="Left" Content="◀" Width="30" Height="34"
                                    Click="OnWorkflowPrev" Style="{StaticResource FlatBtn}" Background="#22FFFFFF"
                                    Foreground="White" FontSize="12"/>
                            <Button x:Name="WorkflowNext" DockPanel.Dock="Right" Content="▶" Width="30" Height="34"
                                    Click="OnWorkflowNext" Style="{StaticResource FlatBtn}" Background="#22FFFFFF"
                                    Foreground="White" FontSize="12"/>
                            <Border Background="#14FFFFFF" CornerRadius="4" Margin="4,0" MinHeight="34">
                                <TextBlock x:Name="WorkflowPick" Text="Cargando workflows…" Foreground="#EEFFFFFF"
                                           FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                           VerticalAlignment="Center" Padding="6,4"/>
                            </Border>
                        </DockPanel>

                        <!-- Vista LISTA: oculta por defecto, se alterna con ☰ -->
                        <ListBox x:Name="WorkflowListBox" Height="128" Visibility="Collapsed"
                                 Background="#14FFFFFF" Foreground="White" BorderThickness="0"
                                 SelectionChanged="OnWorkflowListSelected"/>

                        <Button x:Name="RunWorkflowBtn" Content="▶ Ejecutar ahora" Height="34" Margin="0,8,0,0"
                                Click="OnRunWorkflowDirect" Style="{StaticResource FlatBtn}" Background="#2FB457"
                                Foreground="White" FontWeight="SemiBold" FontSize="12" IsEnabled="False"/>

                        <!-- Ensayo en seco: recorre el plan y dice qué pasaría, SIN tocar la pantalla.
                             Va debajo del verde y en gris a propósito: no es una acción, es una
                             comprobación — se pulsa ANTES de ejecutar, y sobre todo antes de un demo. -->
                        <!-- Puente con la consulta del portal: se pega el código que el médico
                             generó allá, y cuando SAP muestre una pantalla con signos vitales, Ü
                             ofrece llenarlos. Nunca escribe sin que el operador lo apruebe. -->
                        <TextBlock Text="Consulta del portal" Margin="0,14,0,4" FontSize="11"
                                   Foreground="#99FFFFFF"/>
                        <DockPanel LastChildFill="True">
                            <Button x:Name="ClinicalPairBtn" Content="Emparejar" DockPanel.Dock="Right"
                                    Width="86" Height="26" Margin="6,0,0,0" Click="OnClinicalPair"
                                    Style="{StaticResource FlatBtn}" Background="#33FFFFFF"
                                    Foreground="#CCFFFFFF" FontSize="11"/>
                            <TextBox x:Name="ClinicalCodeBox" Height="26" MaxLength="8"
                                     CharacterCasing="Upper" FontFamily="Consolas" FontSize="12"
                                     VerticalContentAlignment="Center" Padding="6,0,0,0"
                                     Background="#22FFFFFF" Foreground="White" BorderThickness="0"
                                     ToolTip="El código de 8 caracteres que aparece en la consulta del portal."/>
                        </DockPanel>
                        <TextBlock x:Name="ClinicalStatus" Margin="0,4,0,0" FontSize="10"
                                   Foreground="#99FFFFFF" TextWrapping="Wrap"
                                   Text="Sin emparejar."/>

                        <!-- El ejecutor de exportaciones: atiende la cola de Graph (claim → workflow
                             en SAP → result). «Exportada» solo cuando SAP publica su señal de éxito,
                             y el resultado se reintenta hasta el ack — nunca best-effort. Ver
                             NoteExportExecutor y docs/note-export-contract.md del repo Graph. -->
                        <TextBlock Text="Exportar a historia clínica" Margin="0,14,0,4" FontSize="11"
                                   Foreground="#99FFFFFF"/>
                        <Button x:Name="ExportsBtn" Content="▶ Atender exportaciones" Height="26"
                                Click="OnToggleExports" Style="{StaticResource FlatBtn}"
                                Background="#33FFFFFF" Foreground="#CCFFFFFF" FontSize="11"
                                ToolTip="Reclama trabajos de exportación de Graph y ejecuta el workflow en SAP. Solo reporta éxito con la confirmación de SAP verificada."/>
                        <TextBlock x:Name="ExportsStatus" Margin="0,4,0,0" FontSize="10"
                                   Foreground="#99FFFFFF" TextWrapping="Wrap"
                                   Text="Apagado. Enciéndelo para atender la cola."/>

                        <!-- Paso a paso: no ejecuta distinto, ejecuta PAUSADO. Se queda encendido
                             entre corridas a propósito: si lo enciendes es porque estás depurando. -->
                        <Button x:Name="StepModeBtn" Height="26" Margin="0,14,0,0" Click="OnToggleStepMode"
                                Style="{StaticResource FlatBtn}" Background="#33FFFFFF" Foreground="#CCFFFFFF"
                                FontSize="11"
                                ToolTip="Ejecuta el workflow paso a paso: se detiene ANTES de cada paso y muestra el veredicto y cómo se veía la pantalla al enseñarlo."/>

                        <Button x:Name="DryRunBtn" Content="🧪 Ensayo en seco" Height="26" Margin="0,6,0,0"
                                Click="OnDryRunWorkflow" Style="{StaticResource FlatBtn}" Background="#33FFFFFF"
                                Foreground="#CCFFFFFF" FontSize="11" IsEnabled="False"
                                ToolTip="Comprueba el workflow sin ejecutarlo: qué pasos no resolverían y dónde cambia de pantalla sin un paso que lo provoque. El detalle va a 📜 Logs."/>

                        <!-- Toggle: al enseñar, ¿procesar el video con IA (LLM)? Off = se graba el video y
                             se ve en 🎞 Videos, pero NO se manda al LLM (evita el timeout 504). -->
                        <Button x:Name="VideoLlmToggle" Height="26" Margin="0,8,0,0" Click="OnToggleVideoLlm"
                                Style="{StaticResource FlatBtn}" Background="#33FFFFFF" Foreground="#CCFFFFFF"
                                FontSize="11"
                                ToolTip="Al enseñar: si está OFF, el video NO se manda al LLM (evita el timeout); igual se graba y lo ves en 🎞 Videos."/>

                        <Button x:Name="LogsBtn" Content="📜 Logs" Height="26" Margin="0,6,0,0"
                                Click="OnOpenLogs" Background="#33FFFFFF" Foreground="White" BorderThickness="0"
                                ToolTip="Registro (para diagnosticar errores)"/>

                        <!-- Para soporte: saber qué versión tiene el cliente delante sin pedirle nada. -->
                        <TextBlock x:Name="VersionText" Text="" Foreground="#66FFFFFF" FontSize="10"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>
    </Grid>
</Window>
