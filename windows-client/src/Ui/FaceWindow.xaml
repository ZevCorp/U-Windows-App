<Window x:Class="U.WindowsClient.Ui.FaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:U.WindowsClient.Ui"
        Title="Ü"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight">

    <Window.Resources>
        <!-- Tooltip oscuro y rápido: en una barra de solo iconos, el tooltip ES la etiqueta. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#F01A1A20" BorderBrush="#33FFFFFF" BorderThickness="1"
                                CornerRadius="6" Padding="8,5">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#EEFFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- Botón plano que HONRA su Background en todos los estados. WPF, con el template por defecto,
             pinta un fondo claro del sistema cuando el botón está deshabilitado y deja el Foreground
             blanco → texto blanco sobre fondo blanco. Este template lo arregla: deshabilitado = fondo
             tenue + texto atenuado, siempre legible. -->
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#18FFFFFF"/>
                                <Setter Property="Foreground" Value="#55FFFFFF"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de la BARRA: cuadrado, redondeado, solo icono. El hover es una capa que se funde en
             ~120 ms (no un salto), y el foco de teclado se ve como un aro — la barra se puede operar
             sin ratón. -->
        <!-- El botón de voz que asoma al lado de la carita suelta.
             Pequeño y redondo a propósito: acompaña a la carita, no compite con ella. Nace un poco
             encogido y crece al entrar, que es lo que hace que aparecer se lea como aparecer y no
             como un parpadeo. El micrófono va dibujado y no con un emoji: a 26 px un emoji sale
             borroso y con el color de otro sistema. -->
        <Style x:Key="VoiceDot" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#E6202022"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
            <Setter Property="ToolTipService.Placement" Value="Top"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Ellipse x:Name="bg" Fill="{TemplateBinding Background}"/>
                            <Ellipse x:Name="ring" Stroke="#33FFFFFF" StrokeThickness="1"/>
                            <Ellipse x:Name="hover" Fill="#1FFFFFFF" Opacity="0"/>
                            <!-- Micrófono: cápsula + arco + pie. Trazo fino, como el resto de la cara.
                                 El color sale del Foreground para que pueda invertirse al hablar. -->
                            <Canvas Width="26" Height="26">
                                <Border Canvas.Left="10.5" Canvas.Top="6" Width="5" Height="9"
                                        CornerRadius="2.5" Background="{TemplateBinding Foreground}"/>
                                <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 8.2,12.4 A 4.8,4.8 0 0 0 17.8,12.4"/>
                                <Line X1="13" Y1="17.2" X2="13" Y2="19.6" Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="sc"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.12" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="sc"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.12" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="sc"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="sc"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Fill" Value="#FF3A3A3E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.45" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BarBtn" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
            <Setter Property="ToolTipService.Placement" Value="Left"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="10"/>
                            <Border x:Name="hover" Background="#22FFFFFF" CornerRadius="10" Opacity="0"/>
                            <Border x:Name="focus" BorderBrush="#66FFFFFF" BorderThickness="1.5"
                                    CornerRadius="10" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="focus" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#10FFFFFF"/>
                                <Setter Property="Foreground" Value="#55FFFFFF"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fila del MENÚ EXTENDIDO: icono + nombre alineados a la izquierda. Mismo lenguaje de hover
             que la barra. Los deshabilitados explican su motivo por tooltip (ShowOnDisabled). -->
        <Style x:Key="MenuBtn" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="7"/>
                            <Border x:Name="hover" Background="#1CFFFFFF" CornerRadius="7" Opacity="0"/>
                            <Border x:Name="focus" BorderBrush="#66FFFFFF" BorderThickness="1.5"
                                    CornerRadius="7" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="focus" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#12FFFFFF"/>
                                <Setter Property="Foreground" Value="#55FFFFFF"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Etiqueta de sección del menú extendido. -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#88FFFFFF"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <!-- Separador fino entre grupos. -->
        <Style x:Key="Sep" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#1EFFFFFF"/>
            <Setter Property="Margin" Value="2,10"/>
        </Style>
    </Window.Resources>

    <!-- Carita flotante: overlay permanente, arrastrable, siempre encima. Es TODO el frontend visible.
         No decide nada; solo muestra el estado y recoge lo que el usuario pide.

         Tres piezas en la misma ventana, ancladas a la esquina inferior derecha:
           · BarPanel   — barra vertical compacta, SIEMPRE visible: carita + 4 acciones (micrófono,
                          conversación, enseñar, silencio) + contextuales (⏹, ⬇) + el activador ⌃.
           · TalkPanel  — el globo de conversación (estado, narración, entrada de texto). Aparece solo
                          cuando hay algo que decir o el usuario lo abre con 💬.
           · MenuPanel  — el menú extendido: se abre HACIA ARRIBA al pasar el ratón por el activador
                          (o con clic, que lo fija). Contiene lo secundario y, al final, Backend.
         El estado COLAPSADO (solo la carita suelta) se alterna con un clic en la carita, como siempre.
         Ver FaceWindow.xaml.cs (ToggleCollapsed y la región «menú extendido»). -->
    <Grid>
        <!-- Estado COLAPSADO: solo la carita, como una burbuja flotante. Clic → barra · doble clic →
             micrófono · mantener oprimido → cambia de tema · arrastrar y soltar → se lanza al borde.
             El Margin de 28 deja aire alrededor para que la sombra (blur 24) no se recorte. -->
        <!-- La carita suelta y, a su izquierda, el botón de voz que solo asoma al pasar por encima.
             Van juntos en un panel para que el ratón pueda ir de una al otro sin que el botón se
             desvanezca por el camino: si el hover se midiera solo sobre la carita, el botón
             desaparecería justo cuando vas a pulsarlo. El sitio SIEMPRE está reservado (el botón
             nace invisible, no ausente), así la carita no da un salto al aparecer. -->
        <StackPanel x:Name="CollapsedGroup" Orientation="Horizontal" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="28"
                    Background="Transparent"
                    MouseEnter="OnCollapsedHoverIn" MouseLeave="OnCollapsedHoverOut">

            <!-- DOS PASTILLAS DIMINUTAS que se convierten en botones al acercarse.
                 Es el gesto del Dock de macOS —los iconos crecen cuando te acercas— con la forma
                 del indicador de inicio de iOS: una barrita redondeada que no pide nada. En reposo
                 solo insinúan que hay algo; el icono aparece cuando la mano ya va hacia él.

                 La zona sensible mide 26x26 aunque la pastilla mida 4x16: el blanco de un gesto no
                 puede ser tan pequeño como su dibujo, o acertarle se convierte en puntería. -->
            <StackPanel x:Name="VoiceDotGrupo" Orientation="Vertical" VerticalAlignment="Center"
                        Margin="0,0,10,0" Opacity="0">

                <!-- Voz -->
                <Grid x:Name="ZonaVoz" Width="26" Height="26" Background="Transparent" Cursor="Hand"
                      ToolTip="Hablar con Ü"
                      MouseEnter="OnZonaVozEntra" MouseLeave="OnZonaVozSale"
                      MouseLeftButtonUp="OnMicDesdePastilla">
                    <Ellipse x:Name="VoiceHalo" Width="26" Height="26" Opacity="0"
                             Fill="#FFFFFF" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="VoiceHaloEscala" ScaleX="1" ScaleY="1"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <!-- Rectangle y no Border: su radio de esquina es un número y por tanto se puede
                         ANIMAR. Con Border el radio es una estructura y no se anima, así que había
                         que dejarlo fijo y grande — y un radio grande sobre algo estrecho no es un
                         rectángulo redondeado, es un óvalo (2026-08-07). Aquí el radio viaja con el
                         tamaño: de 1,5 (barrita) a 13 (círculo). -->
                    <Rectangle x:Name="VozCuerpo" Width="4.5" Height="10" RadiusX="2" RadiusY="2"
                               IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <SolidColorBrush x:Name="VozFondo" Color="#80A8A8AE"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Canvas x:Name="VozIcono" Width="26" Height="26" Opacity="0" IsHitTestVisible="False">
                        <Border Canvas.Left="10.5" Canvas.Top="6" Width="5" Height="9"
                                CornerRadius="2.5" Background="White"/>
                        <Path Stroke="White" StrokeThickness="1.3" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" Data="M 8.2,12.4 A 4.8,4.8 0 0 0 17.8,12.4"/>
                        <Line X1="13" Y1="17.2" X2="13" Y2="19.6" Stroke="White"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                </Grid>

                <!-- Conversación -->
                <Grid x:Name="ZonaChat" Width="26" Height="26" Background="Transparent" Cursor="Hand"
                      Margin="0,1,0,0" ToolTip="Escribirle a Ü"
                      MouseEnter="OnZonaChatEntra" MouseLeave="OnZonaChatSale"
                      MouseLeftButtonUp="OnChatDesdePastilla">
                    <Rectangle x:Name="ChatCuerpo" Width="4.5" Height="10" RadiusX="2" RadiusY="2"
                               IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <SolidColorBrush x:Name="ChatFondo" Color="#80A8A8AE"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Canvas x:Name="ChatIcono" Width="26" Height="26" Opacity="0" IsHitTestVisible="False">
                        <!-- Bocadillo: cuerpo redondeado y la puntita abajo a la izquierda. -->
                        <Border Canvas.Left="6" Canvas.Top="7" Width="14" Height="10"
                                CornerRadius="5" BorderBrush="White" BorderThickness="1.4"/>
                        <Path Stroke="White" StrokeThickness="1.4" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" Data="M 9.5,16.6 L 8.6,19.6 L 12.2,17.2"/>
                    </Canvas>
                </Grid>

                <!-- Dictado clínico. VA AQUÍ Y NO EN LA REJILLA DEL MENÚ porque se usa con las manos
                     puestas en otra cosa: el médico está mirando SAP, no buscando un botón dentro de
                     un panel. Las otras dos pastillas hablan CON Ü; ésta no habla con nadie —
                     transcribe y rellena— y por eso merece su propio gesto en vez de un modo del
                     micrófono.

                     Solo hace algo en la pantalla de triage: fuera de ahí no hay campos que llenar y
                     encenderlo sería prometer un trabajo que no se puede hacer. -->
                <Grid x:Name="ZonaDictado" Width="26" Height="26" Background="Transparent" Cursor="Hand"
                      Margin="0,1,0,0" ToolTip="Dictar y rellenar los campos de SAP"
                      MouseEnter="OnZonaDictadoEntra" MouseLeave="OnZonaDictadoSale"
                      MouseLeftButtonUp="OnDictadoDesdePastilla">
                    <Rectangle x:Name="DictadoCuerpo" Width="4.5" Height="10" RadiusX="2" RadiusY="2"
                               IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <SolidColorBrush x:Name="DictadoFondo" Color="#80A8A8AE"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Canvas x:Name="DictadoIcono" Width="26" Height="26" Opacity="0" IsHitTestVisible="False">
                        <!-- Fonendoscopio: el tubo en U que baja de las olivas, y la campana. -->
                        <Path Stroke="White" StrokeThickness="1.3" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" Fill="Transparent"
                              Data="M 8,5.5 L 8,10.5 A 4.2,4.2 0 0 0 16.4,10.5 L 16.4,5.5"/>
                        <Path Stroke="White" StrokeThickness="1.3" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" Fill="Transparent"
                              Data="M 12.2,14.7 L 12.2,16.4 A 3.1,3.1 0 0 0 18.4,16.4"/>
                        <Ellipse Canvas.Left="16.2" Canvas.Top="15.4" Width="4.4" Height="4.4"
                                 Stroke="White" StrokeThickness="1.3"/>
                    </Canvas>
                </Grid>
            </StackPanel>

            <ui:FaceControl x:Name="CollapsedFace" Width="72" Height="72" Cursor="Hand"
                            ToolTip="Clic: abrir la barra · doble clic: micrófono · mantener: cambiar tema · arrastrar y soltar: mover">
                <ui:FaceControl.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="Black"/>
                </ui:FaceControl.Effect>
            </ui:FaceControl>
        </StackPanel>

        <!-- Estado NORMAL: menú extendido (arriba) + globo de conversación (izquierda) + barra (derecha).
             La ventana mide lo que mida el contenido (SizeToContent) y OnSizeChanged la mantiene
             anclada a la esquina inferior derecha: abrir el menú crece hacia arriba y a la izquierda. -->
        <!-- Dos filas y no un StackPanel: la barra es la fila Auto y el menú la fila «*». Así, cuando
             el contenido excede el MaxHeight de la ventana, quien cede es el MENÚ (que hace scroll),
             nunca la barra. Con un StackPanel el recorte se comía el último hijo — es decir, la
             interfaz permanente — y encima dependía de que yo calculara bien una altura a mano. -->
        <Grid x:Name="RootPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- MENÚ EXTENDIDO: se abre hacia arriba desde el activador. No es una ventana aparte:
                 es la continuación de la barra. Si no cabe, MenuScroll hace scroll interno — el
                 tope lo pone la fila, no una cuenta nuestra. -->
            <Border x:Name="MenuPanel" Grid.Row="0" VerticalAlignment="Bottom"
                    Width="292" HorizontalAlignment="Right" Visibility="Collapsed"
                    CornerRadius="14" Background="#F2101014" BorderBrush="#33FFFFFF" BorderThickness="1"
                    Padding="10" Margin="0,0,0,8">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="MenuShift"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="Black"/>
                </Border.Effect>
                <ScrollViewer x:Name="MenuScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- ── Lo que se sacó de la barra ──────────────────────────────────────
                             La barra vive encima del trabajo de alguien y solo debería tener lo que
                             esa persona usa. Hablar y escribir ya están en la carita —las dos
                             pastillas—, y enseñar y silenciar son de quien desarrolla, no de quien
                             trabaja. Se conservan enteros, con su nombre y su manejador: mover algo
                             de sitio no es reescribirlo (2026-08-07). -->
                        <TextBlock Text="Acciones" Style="{StaticResource SectionLabel}"/>
                        <!-- Cinco: se añadió 📿 (el collar Omi) el 2026-08-13. Va aquí y no escondido
                             en el panel de desarrollo porque enlazar el collar lo hace el usuario una
                             vez, no es una herramienta de diagnóstico.
                             Seis desde el 2026-08-15 con 🔄 (buscar actualizaciones a mano). -->
                        <UniformGrid Columns="6" Margin="0,4,0,10">
                            <!-- PreviewMouseLeftButtonDown y no MouseDown: el estilo del botón marca el
                                 evento como manejado, así que sin Preview no llega nunca y el gesto de
                                 mantener pulsado no se podría medir. -->
                            <Button x:Name="MicBtn" Content="🎤" Style="{StaticResource BarBtn}" Click="OnMic"
                                    PreviewMouseLeftButtonDown="OnMicDown"
                                    Margin="0" ToolTip="Hablarle a Ü · mantener pulsado = por el collar Omi"
                                    AutomationProperties.Name="Micrófono"/>
                            <Button x:Name="TalkBtn" Content="💬" Style="{StaticResource BarBtn}"
                                    Margin="0" ToolTip="Conversación: estado, respuestas y entrada de texto"
                                    AutomationProperties.Name="Conversación"/>
                            <!-- Enseñanza activa: graba pantalla+voz para que Ü aprenda a usar una
                                 app. En rojo mientras graba (SetTeachingUi). -->
                            <Button x:Name="TeachBtn" Content="🎓" Style="{StaticResource BarBtn}" Click="OnToggleTeach"
                                    Margin="0" ToolTip="Enseñar: Ü graba la pantalla y tu voz para aprender un workflow"
                                    AutomationProperties.Name="Enseñar"/>
                            <Button x:Name="CollarBtn" Content="📿" Style="{StaticResource BarBtn}" Click="OnCollar"
                                    Margin="0" ToolTip="Collar Omi — enlazar y ver su estado"
                                    AutomationProperties.Name="Collar Omi"/>
                            <!-- Demo: radicación por chat. Aparte del núcleo a propósito — ver
                                 windows-client/src/Radicacion/. -->
                            <Button x:Name="RadicacionBtn" Content="🧾" Style="{StaticResource BarBtn}" Click="OnRadicacion"
                                    Margin="0" ToolTip="Radicación por chat (demo) — adjuntar y clasificar documentos"
                                    AutomationProperties.Name="Radicación"/>
                            <Button x:Name="MuteBtn" Content="🔊" Style="{StaticResource BarBtn}" Click="OnToggleMute"
                                    Margin="0" ToolTip="Callar a Ü ahora mismo" AutomationProperties.Name="Silencio"/>
                            <!-- Buscar actualizaciones AHORA. El sondeo automático mira cada 30 min y
                                 no dice nada mientras tanto —correcto para no molestar—, pero deja sin
                                 respuesta a quien acaba de enterarse de que hay versión nueva. Sin
                                 esto, la única forma de forzarlo era cerrar y volver a abrir. -->
                            <Button x:Name="CheckUpdateBtn" Content="🔄" Style="{StaticResource BarBtn}" Click="OnCheckUpdate"
                                    Margin="0" ToolTip="Buscar actualizaciones ahora"
                                    AutomationProperties.Name="Buscar actualizaciones"/>
                        </UniformGrid>

                        <!-- ── Ejecutar workflow: lo que el operador usa a diario ─────────────── -->
                        <DockPanel LastChildFill="False" Margin="0,0,0,3">
                            <TextBlock DockPanel.Dock="Left" Text="Ejecutar workflow"
                                       Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                            <Button x:Name="WorkflowViewToggle" DockPanel.Dock="Right" Content="☰" Width="26" Height="20"
                                    Click="OnToggleWorkflowView" Style="{StaticResource FlatBtn}" Background="#22FFFFFF"
                                    Foreground="#CCFFFFFF" FontSize="11" ToolTip="Cambiar entre carrusel y lista"/>
                            <Button x:Name="WorkflowDeleteBtn" DockPanel.Dock="Right" Content="🗑" Width="26" Height="20"
                                    Margin="0,0,6,0" Click="OnDeleteWorkflow" Style="{StaticResource FlatBtn}"
                                    Background="#33FF3B30" Foreground="#EEFFFFFF" FontSize="11" IsEnabled="False"
                                    ToolTip="Borrar el workflow que se muestra (no se puede deshacer)"/>
                        </DockPanel>

                        <!-- Vista CARRUSEL: flecha ◀, título centrado, flecha ▶ -->
                        <DockPanel x:Name="WorkflowCarousel" LastChildFill="True">
                            <Button x:Name="WorkflowPrev" DockPanel.Dock="Left" Content="◀" Width="30" Height="34"
                                    Click="OnWorkflowPrev" Style="{StaticResource FlatBtn}" Background="#22FFFFFF"
                                    Foreground="White" FontSize="12"/>
                            <Button x:Name="WorkflowNext" DockPanel.Dock="Right" Content="▶" Width="30" Height="34"
                                    Click="OnWorkflowNext" Style="{StaticResource FlatBtn}" Background="#22FFFFFF"
                                    Foreground="White" FontSize="12"/>
                            <Border Background="#14FFFFFF" CornerRadius="4" Margin="4,0" MinHeight="34">
                                <TextBlock x:Name="WorkflowPick" Text="Cargando workflows…" Foreground="#EEFFFFFF"
                                           FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                           VerticalAlignment="Center" Padding="6,4"/>
                            </Border>
                        </DockPanel>

                        <!-- Vista LISTA: oculta por defecto, se alterna con ☰ -->
                        <ListBox x:Name="WorkflowListBox" Height="128" Visibility="Collapsed"
                                 Background="#14FFFFFF" Foreground="White" BorderThickness="0"
                                 SelectionChanged="OnWorkflowListSelected"/>

                        <Button x:Name="RunWorkflowBtn" Content="▶ Ejecutar ahora" Height="34" Margin="0,8,0,0"
                                Click="OnRunWorkflowDirect" Style="{StaticResource MenuBtn}" Background="#2FB457"
                                HorizontalContentAlignment="Center" FontWeight="SemiBold" FontSize="12" IsEnabled="False"
                                ToolTip="Corre el workflow seleccionado contra Graph (se alinea solo si la pantalla no coincide)"/>

                        <!-- Ensayo en seco: recorre el plan y dice qué pasaría, SIN tocar la pantalla.
                             Va debajo del verde y en gris a propósito: no es una acción, es una
                             comprobación — se pulsa ANTES de ejecutar, y sobre todo antes de un demo. -->
                        <Button x:Name="DryRunBtn" Content="🧪 Ensayo en seco" Height="26" Margin="0,6,0,0"
                                Click="OnDryRunWorkflow" Style="{StaticResource MenuBtn}" Background="#33FFFFFF"
                                Foreground="#CCFFFFFF" IsEnabled="False"
                                ToolTip="Comprueba el workflow sin ejecutarlo: qué pasos no resolverían y dónde cambia de pantalla sin un paso que lo provoque. El detalle va a 📜 Logs."/>

                        <!-- Paso a paso: no ejecuta distinto, ejecuta PAUSADO. Se queda encendido
                             entre corridas a propósito: si lo enciendes es porque estás depurando. -->
                        <Button x:Name="StepModeBtn" Height="26" Margin="0,6,0,0" Click="OnToggleStepMode"
                                Style="{StaticResource MenuBtn}" Background="#33FFFFFF" Foreground="#CCFFFFFF"
                                ToolTip="Ejecuta el workflow paso a paso: se detiene ANTES de cada paso y muestra el veredicto y cómo se veía la pantalla al enseñarlo."/>

                        <!-- Biblioteca y videos: utilidades del mismo mundo que el runner. -->
                        <Button x:Name="WorkflowsBtn" Content="🧭 Workflows" Height="26" Margin="0,10,0,0"
                                Click="OnOpenWorkflows" Style="{StaticResource MenuBtn}"
                                ToolTip="Biblioteca de workflows: ejecutar contra Graph (SAP GUI / UIA) + autofill"/>
                        <Button x:Name="VideosBtn" Content="🎞 Videos" Height="26" Margin="0,6,0,0"
                                Click="OnOpenVideos" Style="{StaticResource MenuBtn}"
                                ToolTip="Las grabaciones de tus enseñanzas"/>

                        <Border Style="{StaticResource Sep}"/>

                        <!-- ── Puente con la consulta del portal: se pega el código que el médico
                             generó allá, y cuando SAP muestre una pantalla con signos vitales, Ü
                             ofrece llenarlos. Nunca escribe sin que el operador lo apruebe. ────── -->
                        <TextBlock Text="Consulta del portal" Margin="0,0,0,4"
                                   Style="{StaticResource SectionLabel}"/>
                        <DockPanel LastChildFill="True">
                            <Button x:Name="ClinicalPairBtn" Content="Emparejar" DockPanel.Dock="Right"
                                    Width="86" Height="26" Margin="6,0,0,0" Click="OnClinicalPair"
                                    Style="{StaticResource MenuBtn}" Background="#33FFFFFF"
                                    Foreground="#CCFFFFFF" HorizontalContentAlignment="Center"/>
                            <TextBox x:Name="ClinicalCodeBox" Height="26" MaxLength="8"
                                     CharacterCasing="Upper" FontFamily="Consolas" FontSize="12"
                                     VerticalContentAlignment="Center" Padding="6,0,0,0"
                                     Background="#22FFFFFF" Foreground="White" BorderThickness="0"
                                     ToolTip="El código de 8 caracteres que aparece en la consulta del portal."/>
                        </DockPanel>
                        <TextBlock x:Name="ClinicalStatus" Margin="0,4,0,0" FontSize="10"
                                   Foreground="#99FFFFFF" TextWrapping="Wrap"
                                   Text="Sin emparejar."/>

                        <Border Style="{StaticResource Sep}"/>

                        <!-- ── Backend: herramientas de desarrollo. Sección secundaria, PLEGADA por
                             defecto — se abre y se cierra CON CLIC, y no compite visualmente con lo
                             que usa el operador. El contenido conserva su apariencia técnica.
                             El hover que la abría se quitó: rozarla la desplegaba sola y el clic
                             entonces no cambiaba nada, así que el control parecía roto. ────────── -->
                        <StackPanel x:Name="BackendZone">
                            <Border x:Name="BackendHeader" CornerRadius="8" Background="#1CFFFFFF" Height="30"
                                    Cursor="Hand" Focusable="True"
                                    ToolTip="Clic para abrir o cerrar las herramientas de desarrollo"
                                    AutomationProperties.Name="Backend — herramientas de desarrollo">
                                <DockPanel LastChildFill="True" Margin="10,0">
                                    <Path x:Name="BackendChevron" DockPanel.Dock="Left" Data="M 0 0 L 4.5 4.5 L 0 9"
                                          Stroke="#CCFFFFFF" StrokeThickness="1.6" StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="BackendRot" Angle="0"/>
                                        </Path.RenderTransform>
                                    </Path>
                                    <!-- Señal de conexión con Graph, visible sin abrir la sección. NO
                                         dice «hay API key» —eso decía antes, y por eso estaba verde
                                         mientras el DNS fallaba—: dice qué pasó la última vez que se
                                         habló con Graph, y el tooltip añade cuándo. Los siete estados
                                         y sus colores viven en GraphHealthText. -->
                                    <Ellipse x:Name="BackendDot" DockPanel.Dock="Right" Width="7" Height="7"
                                             Fill="#8A8A8E" VerticalAlignment="Center"/>
                                    <TextBlock Text="Backend" Foreground="#CCFFFFFF" FontSize="11"
                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <StackPanel x:Name="BackendBody" Visibility="Collapsed" Margin="0,6,0,0">
                                <!-- El backend ya no se configura a mano: la URL tiene default sano y la
                                     API key llega sola (key embebida en el build de distribución, o env
                                     GRAPH_API_KEY en dev). Esto es solo un estado de diagnóstico. Ver
                                     GraphConfig.Load y el doc "Distribución conectada". -->
                                <TextBlock x:Name="BackendStatus" Foreground="#88FFFFFF" FontSize="10"
                                           TextWrapping="Wrap" Margin="0,0,0,2"/>

                                <!-- Qué atajo global quedó ACTIVO. Se enseña porque puede no ser el
                                     preferido: si otra aplicación ya tenía la combinación, se registra
                                     la de respaldo, y anunciar la que no es sería peor que no decir
                                     nada. Lo rellena OnSourceInitialized. -->
                                <TextBlock x:Name="HotkeyStatus" Foreground="#88FFFFFF" FontSize="10"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>

                                <!-- Inspector visual de elementos (estilo TalkBack): dibuja recuadros sobre
                                     la pantalla; al hacer clic, amarillo si coincide con lo que el asistente
                                     tocaría, rojo doble si no. Ver UiInspector. -->
                                <Button x:Name="InspectorBtn" Content="🔍 Inspector de elementos" Height="26" Margin="0,8,0,0"
                                        Click="OnToggleInspector" Style="{StaticResource MenuBtn}" Background="#33FFFFFF"
                                        ToolTip="Muestra recuadros sobre los elementos de la pantalla. Al hacer clic: amarillo si coincide con lo que el asistente tocaría, rojo (ambos) si no."/>

                                <!-- El "location bar de Windows": ID de superficie actual, arriba a la derecha.
                                     Mismo formato que source_url de los workflows (uia:// y web://). -->
                                <Button x:Name="LocatorBtn" Content="📍 ID visible — clic para ocultar" Height="26" Margin="0,6,0,0"
                                        Click="OnToggleLocator" Style="{StaticResource MenuBtn}" Background="#33FFFFFF"
                                        ToolTip="Muestra dónde estás parado como URL: uia://app.exe/ventana o web://dominio/ruta. Es el ID con el que se cargan los workflows."/>

                                <!-- El grafo TOCABLE: la ventana actual expone sus elementos como aristas;
                                     hover = iluminar el botón real, clic = pulsarlo de verdad y aprender la
                                     arista con certeza absoluta. Ver GraphExplorerWindow. -->
                                <Button x:Name="ExplorerBtn" Content="🕸 Explorar el grafo" Height="26" Margin="0,6,0,0"
                                        Click="OnToggleExplorer" Style="{StaticResource MenuBtn}" Background="#33FFFFFF"
                                        ToolTip="Las aristas de la pantalla actual, en vivo. Hover: ilumina el elemento real. Clic: lo pulsa de verdad y aprende la ruta."/>

                                <!-- El grafo pre-aprendido, visible: pantallas como nodos, saltos como aristas,
                                     y el nodo actual iluminado mientras navegas. Ver WorkflowMapWindow. -->
                                <Button x:Name="MapBtn" Content="🗺 Mapa del grafo" Height="26" Margin="0,6,0,0"
                                        Click="OnToggleMap" Style="{StaticResource MenuBtn}" Background="#33FFFFFF"
                                        ToolTip="Dibuja los workflows como un grafo de pantallas. Dos workflows que pasan por la misma pantalla comparten nodo: ahí se concatenan."/>

                                <!-- TODO ENCENDIDO DE UN GOLPE. Ver la pantalla entera anotada exige cuatro
                                     interruptores, y hasta ahora había que acordarse de los cuatro y del
                                     orden. Un solo botón para el modo «quiero verlo todo». -->
                                <Button x:Name="FullTooltipsBtn" Content="👁 Full Tooltips" Height="26" Margin="0,6,0,0"
                                        Click="OnToggleFullTooltips" Style="{StaticResource MenuBtn}" Background="#33FFFFFF"
                                        ToolTip="Enciende de una vez el inspector, el ID de superficie, el explorador del grafo y el mapa. Volver a pulsarlo lo apaga todo."/>

                                <!-- INTERRUPTOR DE MEDICIÓN, duro y sin respaldo. Ver AgentLoop.SoloGrafo:
                                     con computer-use de red no se puede saber cuál de los dos llegó. -->
                                <Button x:Name="SoloGrafoBtn" Content="🕸 Navegación: GRAFO + coordenadas" Height="26" Margin="0,6,0,0"
                                        Click="OnToggleSoloGrafo" Style="{StaticResource MenuBtn}" Background="#33FFFFFF"
                                        ToolTip="Botón de DESARROLLO, para medir. Al ponerlo en SOLO GRAFO el asistente pierde tap/type/scroll/swipe/key: solo puede moverse con rutas del grafo (ir_a). Si el grafo no conoce el camino, se detiene — no lo rodea con clics a coordenadas. Cada negativa queda en el log con la marca «SOLO GRAFO»."/>

                                <!-- Toggle: al enseñar, ¿procesar el video con IA (LLM)? Off = se graba el
                                     video y se ve en 🎞 Videos, pero NO se manda al LLM (evita el 504). -->
                                <Button x:Name="VideoLlmToggle" Height="26" Margin="0,6,0,0" Click="OnToggleVideoLlm"
                                        Style="{StaticResource MenuBtn}" Background="#33FFFFFF" Foreground="#CCFFFFFF"
                                        ToolTip="Al enseñar: si está OFF, el video NO se manda al LLM (evita el timeout); igual se graba y lo ves en 🎞 Videos."/>

                                <Button x:Name="LogsBtn" Content="📜 Logs" Height="26" Margin="0,6,0,0"
                                        Click="OnOpenLogs" Style="{StaticResource MenuBtn}" Background="#33FFFFFF"
                                        ToolTip="Registro (para diagnosticar errores)"/>

                                <!-- Para soporte: saber qué versión tiene el cliente delante sin pedir nada. -->
                                <TextBlock x:Name="VersionText" Text="" Foreground="#66FFFFFF" FontSize="10"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Fila inferior: el globo de conversación a la izquierda, la barra a la derecha. -->
            <DockPanel x:Name="BarRow" Grid.Row="1" HorizontalAlignment="Right" LastChildFill="False">

                <!-- GLOBO DE CONVERSACIÓN: estado + narración + entrada de texto. Aparece solo cuando
                     hay algo que decir (narración, una pregunta, una ejecución en curso) o cuando el
                     usuario lo abre con 💬. Se cierra con ✕ o Esc; lo que muestre sigue actualizándose
                     aunque esté cerrado (Status/Bubble viven aquí). -->
                <Border x:Name="TalkPanel" DockPanel.Dock="Left" Width="252" Visibility="Collapsed"
                        VerticalAlignment="Bottom" CornerRadius="14" Background="#F2101014"
                        BorderBrush="#33FFFFFF" BorderThickness="1" Padding="12" Margin="0,0,8,0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="TalkShift"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Button x:Name="TalkCloseBtn" DockPanel.Dock="Right" Content="✕" Width="22" Height="22"
                                    Style="{StaticResource FlatBtn}" Background="#22FFFFFF" FontSize="10"
                                    Margin="6,0,0,0" VerticalAlignment="Top" ToolTip="Cerrar (Esc)"
                                    AutomationProperties.Name="Cerrar la conversación"/>
                            <TextBlock x:Name="Status" Text="Ü listo" Foreground="#EEFFFFFF" FontSize="12.5"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Globo de narración: crece con el texto (la ventana se expande hacia arriba) y,
                             si el texto excede el máximo, hace scroll en vez de cortarse. -->
                        <ScrollViewer MaxHeight="320" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="Bubble" Text="" Foreground="#CCFFFFFF" FontSize="12"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>

                        <!-- Entrada de texto: también resuelve las preguntas del asistente (AskAsync
                             abre este globo y enfoca la caja). El micrófono vive en la barra. -->
                        <TextBox x:Name="Input" Height="30" Margin="0,10,0,0" VerticalContentAlignment="Center"
                                 Background="#22FFFFFF" Foreground="White" BorderThickness="0" Padding="8,0"
                                 KeyDown="OnInputKey" ToolTip="Escríbele a Ü y pulsa Enter"/>
                    </StackPanel>
                </Border>

                <!-- LA BARRA: vertical, estrecha, siempre disponible. Arrastrable por cualquier zona
                     libre (y por la carita). De arriba a abajo: la zona contextual (⬇ ⏹ 🔄, que
                     aparecen y desaparecen), el activador del menú, las acciones fijas y, abajo del
                     todo, la carita.

                     Ese orden no es estético, es aritmética. El borde INFERIOR de la barra está
                     clavado (la ventana se ancla por la esquina), así que cuando la barra crece, crece
                     hacia arriba: un botón que aparece empuja 44 px hacia arriba a todo lo que tenga
                     ENCIMA y no mueve nada de lo que tenga debajo. Con los contextuales en medio, el
                     activador saltaba justo cuando el usuario iba hacia él. Poniéndolos arriba del
                     todo no queda nadie por encima y el desplazamiento es cero para todos.

                     Lo demás: el activador va sobre las acciones porque el menú nace justo encima, y
                     la carita va abajo porque ahí vive la burbuja cuando se colapsa — así no salta de
                     sitio al alternar entre los dos estados. -->
                <Border x:Name="BarPanel" DockPanel.Dock="Right" CornerRadius="18" Background="#F2101014"
                        Padding="8,10" BorderBrush="#33FFFFFF" BorderThickness="1" VerticalAlignment="Bottom">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- ZONA CONTEXTUAL: lo que solo existe a ratos. Va envuelta para que el
                             separador se colapse con ella (si no, queda una raya flotando sobre nada)
                             y para que su visibilidad se decida en UN sitio: UpdateContextZone(). -->
                        <StackPanel x:Name="ContextZone" Visibility="Collapsed">
                            <!-- Pastilla de actualización: oculta salvo que ya haya una versión descargada
                                 y lista. Si el usuario la ignora, se aplica sola al cerrar (ApplyOnExit). -->
                            <Button x:Name="UpdateBtn" Content="⬇" Style="{StaticResource BarBtn}"
                                    Margin="0" Background="#553B82F6" Visibility="Collapsed" Click="OnApplyUpdate"
                                    ToolTip="Nueva versión lista — clic para reiniciar (si no, se instala sola al cerrar Ü)"
                                    AutomationProperties.Name="Aplicar la actualización"/>

                            <!-- Solo visible mientras ejecuta algo: detener es detener, también la voz. -->
                            <Button x:Name="StopBtn" Content="⏹" Style="{StaticResource BarBtn}"
                                    Background="#55FF3B30" Visibility="Collapsed" Click="OnStop"
                                    ToolTip="Detener lo que está haciendo"
                                    AutomationProperties.Name="Detener"/>

                            <!-- Descartar lo grabado y volver a empezar. Sigue inerte: el reinicio en
                                 caliente aún no existe en la enseñanza unificada (ver OnRestartTeach y
                                 el follow-up WorkflowTeachSession.RestartAsync). Se conserva a
                                 propósito, no por olvido. -->
                            <Button x:Name="RestartTeachBtn" Content="🔄" Style="{StaticResource BarBtn}"
                                    Visibility="Collapsed" Click="OnRestartTeach"
                                    ToolTip="Me equivoqué: descartar esta grabación y empezar de nuevo"
                                    AutomationProperties.Name="Rehacer la enseñanza"/>

                            <Border Background="#1EFFFFFF" Height="1" Margin="6,8,6,0"/>
                        </StackPanel>

                        <!-- ACTIVADOR del menú extendido: hover lo abre (hacia arriba, justo encima),
                             clic lo fija, Esc lo cierra. El chevron apunta a donde va a nacer el menú;
                             girado significa «ciérralo». Ver UpdateChevron(). -->
                        <Button x:Name="MenuActivator" Height="26" Margin="0,4,0,0" Style="{StaticResource BarBtn}"
                                Width="38" FontSize="11" Background="#00FFFFFF"
                                ToolTip="Más herramientas (hover abre · clic fija · Esc cierra)"
                                AutomationProperties.Name="Más herramientas">
                            <Path x:Name="ActivatorChevron" Data="M 0 5 L 6 0 L 12 5"
                                  Stroke="#CCFFFFFF" StrokeThickness="1.8" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="ActivatorRot" Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Button>

                        <Border Background="#1EFFFFFF" Height="1" Margin="6,6,6,0"/>

                        <!-- LOS TRES MODOS DE Ü, de arriba abajo: autónomo, proactividad, aprendizaje.
                             Aún no hacen nada: primero se decide cómo se ven y dónde viven, y después
                             qué hacen — al revés, la forma acaba dictada por lo primero que se cableó.

                             Los iconos van DIBUJADOS y no como emoji. Un emoji lo pinta la fuente del
                             sistema: trae su propio color, su propio peso y su propio estilo, así que
                             cuatro emojis juntos son cuatro dibujos de cuatro autores distintos —que
                             es exactamente lo que se veía—. Estos son trazo de 1,5 con extremos
                             redondeados, el mismo lápiz que la carita (2026-08-07). -->

                        <Button x:Name="AutonomoBtn" Style="{StaticResource BarBtn}"
                                ToolTip="Autónomo: Ü actúa por su cuenta"
                                AutomationProperties.Name="Autónomo">
                            <!-- Un ciclo que se cierra solo, con su punta de flecha: anda sin que nadie
                                 lo empuje. -->
                            <Canvas Width="20" Height="20">
                                <Path Stroke="#E8FFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 16.2,7.4 A 7,7 0 1 0 17,10.6"/>
                                <Path Stroke="#E8FFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 13.4,7.6 L 16.6,7.1 L 16.1,3.9"/>
                                <Ellipse Canvas.Left="8.2" Canvas.Top="8.2" Width="3.6" Height="3.6"
                                         Fill="#E8FFFFFF"/>
                            </Canvas>
                        </Button>

                        <Button x:Name="ProactividadBtn" Style="{StaticResource BarBtn}"
                                ToolTip="Proactividad: Ü se adelanta y propone"
                                AutomationProperties.Name="Proactividad">
                            <!-- Destellos: lo que aparece sin haberlo pedido. -->
                            <Canvas Width="20" Height="20">
                                <Path Fill="#E8FFFFFF"
                                      Data="M 8,2.6 L 9.35,6.85 L 13.6,8.2 L 9.35,9.55 L 8,13.8
                                            L 6.65,9.55 L 2.4,8.2 L 6.65,6.85 Z"/>
                                <Path Fill="#E8FFFFFF"
                                      Data="M 14.8,11.6 L 15.55,13.65 L 17.6,14.4 L 15.55,15.15
                                            L 14.8,17.2 L 14.05,15.15 L 12,14.4 L 14.05,13.65 Z"/>
                            </Canvas>
                        </Button>

                        <Button x:Name="AprendizajeBtn" Style="{StaticResource BarBtn}"
                                ToolTip="Aprendizaje: lo que Ü está aprendiendo"
                                AutomationProperties.Name="Aprendizaje">
                            <!-- Un libro abierto: lo que se lee para aprender. -->
                            <Canvas Width="20" Height="20">
                                <Path Stroke="#E8FFFFFF" StrokeThickness="1.5" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 10,6 C 8.6,4.5 6,4.1 3.6,4.7 L 3.6,15 C 6,14.4 8.6,14.8 10,16.3
                                            C 11.4,14.8 14,14.4 16.4,15 L 16.4,4.7 C 14,4.1 11.4,4.5 10,6 Z"/>
                                <Path Stroke="#E8FFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Data="M 10,6 L 10,16.3"/>
                            </Canvas>
                        </Button>

                        <!-- EL COLLAR OMI. Cuarto de la tira, y aquí y no sólo en el panel grande
                             porque es donde el usuario mira: la fila de acciones vive dos pantallas
                             más adentro (2026-08-13, lo dijo al no encontrarlo).

                             Dibujado con el mismo lápiz que sus vecinos —trazo 1,5, extremos
                             redondeados— y no con un emoji, por lo que explica el comentario de
                             arriba: un emoji trae su propio color y su propio peso, y rompe la tira. -->
                        <Button x:Name="CollarModoBtn" Style="{StaticResource BarBtn}" Click="OnCollar"
                                ToolTip="Collar Omi: enlazar y ver su estado"
                                AutomationProperties.Name="Collar Omi">
                            <!-- Un collar: el cordón cayendo y la pieza colgando. -->
                            <Canvas Width="20" Height="20">
                                <Path Stroke="#E8FFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 5,4 C 5,11.2 15,11.2 15,4"/>
                                <Ellipse x:Name="CollarPunto" Canvas.Left="7.6" Canvas.Top="11.4"
                                         Width="4.8" Height="4.8" Fill="#E8FFFFFF"/>
                            </Canvas>
                        </Button>

                        <!-- La carita (misma que Android), abajo del todo. Clic → colapsa a solo la
                             carita · doble clic → micrófono · mantener oprimido → cambia de tema ·
                             arrastrar → mover. Y además es el SEMÁFORO del sistema: su gesto y su
                             color dicen qué está pasando (ver FaceMood). -->
                        <ui:FaceControl x:Name="Face" Width="42" Height="42" Cursor="Hand"
                                        HorizontalAlignment="Center" Margin="0,10,0,0"
                                        ToolTip="Clic: solo la carita · doble clic: micrófono · mantener: cambiar tema · arrastrar: mover"/>
                    </StackPanel>
                </Border>

                <!-- LA FRASE CORTA: acompaña a la carita para que el estado no dependa de aprenderse
                     los gestos. Va FUERA de la barra, a su izquierda, y por eso no rompe los 60 DIP de
                     ancho: la ventana está anclada por su borde derecho, así que crecer hacia la
                     izquierda no mueve absolutamente nada (la misma aritmética que hace que los
                     contextuales no empujen al activador).

                     Declarada DESPUÉS de BarPanel a propósito: en un DockPanel los hijos con
                     Dock=Right se apilan de derecha a izquierda en orden de declaración.

                     No es un eco del globo: cuando el globo está abierto, esta píldora se esconde
                     (allí ya está el texto largo). Ver UpdateChip. -->
                <Border x:Name="StatusChip" DockPanel.Dock="Right" Visibility="Collapsed"
                        VerticalAlignment="Bottom" Margin="0,0,8,14"
                        CornerRadius="9" Background="#F01A1A20" BorderBrush="#33FFFFFF" BorderThickness="1"
                        Padding="9,4" MaxWidth="170">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ChipShift"/>
                    </Border.RenderTransform>
                    <TextBlock x:Name="StatusChipText" Foreground="#EEFFFFFF" FontSize="11"
                               TextTrimming="CharacterEllipsis"/>
                </Border>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
