<Window x:Class="U.WindowsClient.Ui.FaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:U.WindowsClient.Ui"
        Title="Ü"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight">

    <Window.Resources>
        <!-- Botón plano que HONRA su Background en todos los estados. WPF, con el template por defecto,
             pinta un fondo claro del sistema cuando el botón está deshabilitado y deja el Foreground
             blanco → texto blanco sobre fondo blanco. Este template lo arregla: deshabilitado = fondo
             tenue + texto atenuado, siempre legible. -->
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#18FFFFFF"/>
                                <Setter Property="Foreground" Value="#55FFFFFF"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de la BARRA: cuadrado, redondeado, solo icono. El hover es una capa que se funde en
             ~120 ms (no un salto), y el foco de teclado se ve como un aro — la barra se puede operar
             sin ratón. -->
        <Style x:Key="BarBtn" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="14"/>
                            <Border x:Name="hover" Background="#12000000" CornerRadius="14" Opacity="0"/>
                            <Border x:Name="focus" BorderBrush="#66FFFFFF" BorderThickness="1.5"
                                    CornerRadius="14" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="focus" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#10FFFFFF"/>
                                <Setter Property="Foreground" Value="#55FFFFFF"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fila del MENÚ EXTENDIDO: icono + nombre alineados a la izquierda. Mismo lenguaje de hover
             que la barra. Los deshabilitados explican su motivo por tooltip (ShowOnDisabled). -->
        <Style x:Key="MenuBtn" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="10"/>
                            <Border x:Name="hover" Background="#1CFFFFFF" CornerRadius="10" Opacity="0"/>
                            <Border x:Name="focus" BorderBrush="#66FFFFFF" BorderThickness="1.5"
                                    CornerRadius="10" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="focus" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#12FFFFFF"/>
                                <Setter Property="Foreground" Value="#55FFFFFF"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Etiqueta de sección del menú extendido. -->
        <!-- El mismo rotulo que Estudio.Rotulo en las ventanas claras: 10 px, negrita, tenue.
             Un sistema de diseno se reconoce antes por la jerarquia del texto que por el color. -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#99EAF2FF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Separador fino entre grupos. -->
        <Style x:Key="Sep" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#1EFFFFFF"/>
            <Setter Property="Margin" Value="2,12"/>
        </Style>
    </Window.Resources>

    <!-- Carita flotante: overlay permanente, arrastrable, siempre encima. Es TODO el frontend visible.
         No decide nada; solo muestra el estado y recoge lo que el usuario pide.

         Tres piezas en la misma ventana, ancladas a la esquina inferior derecha:
           · BarPanel   — barra vertical compacta, SIEMPRE visible: carita + 4 acciones (micrófono,
                          conversación, enseñar, silencio) + contextuales (⏹, ⬇) + el activador ⌃.
           · TalkPanel  — el globo de conversación (estado, narración, entrada de texto). Aparece solo
                          cuando hay algo que decir o el usuario lo abre con 💬.
           · MenuPanel  — el menú extendido: se abre HACIA ARRIBA al pasar el ratón por el activador
                          (o con clic, que lo fija). Contiene lo secundario y, al final, Backend.
         El estado COLAPSADO (solo la carita suelta) se alterna con un clic en la carita, como siempre.
         Ver FaceWindow.xaml.cs (ToggleCollapsed y la región «menú extendido»). -->
    <Grid>
        <!-- Estado COLAPSADO: solo la carita, como una burbuja flotante. Clic → barra · doble clic →
             micrófono · mantener oprimido → cambia de tema · arrastrar y soltar → se lanza al borde.
             El Margin de 28 deja aire alrededor para que la sombra (blur 24) no se recorte.

             Hasta el 2026-09-02 aquí asomaban tres pastillas al acercar el ratón —hablar, escribir,
             dictar a SAP—. Se retiraron (spec 008, promesa 112): hablarle es lo que más se hace y
             no puede estar detrás de acertarle a una barrita de 4,5 px, la de escribir no hacía
             nada en este estado, y el dictado a SAP no lo usaba nadie. La carita es el botón. -->
        <!-- El halo va DETRÁS de la carita y en el mismo Grid: un Grid superpone a sus hijos, así
             que crecer con la voz no empuja nada ni cambia el tamaño de la ventana. Hasta el
             2026-09-02 vivía detrás de la pastilla del micrófono; sin pastillas, la señal de «te
             estoy oyendo» es la carita misma. El color lo pone PintarHalo: azul por el collar,
             gris por el micrófono del PC. -->
        <StackPanel x:Name="CollapsedGroup" Orientation="Horizontal" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="28"
                    Background="Transparent"
                    MouseEnter="OnCollapsedHoverIn" MouseLeave="OnCollapsedHoverOut">
            <!-- EL HALO DE LA VOZ, alrededor de la carita entera. Hasta el 2026-09-02 vivia
                 dentro de la pastilla del microfono, que media 26x26; al morir la pastilla, la
                 senal de «te estoy oyendo» pasa a ser la carita misma. El tamano y el color los
                 pone ReglaDelHalo. -->
            <Grid>
                <Ellipse x:Name="VoiceHalo" Width="72" Height="72" Opacity="0"
                         IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Fill>
                        <SolidColorBrush x:Name="VoiceHaloColor" Color="#A8A8AE"/>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="VoiceHaloEscala" ScaleX="1" ScaleY="1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <ui:FaceControl x:Name="CollapsedFace" Width="72" Height="72" Cursor="Hand">
                    <ui:FaceControl.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="Black"/>
                    </ui:FaceControl.Effect>
                </ui:FaceControl>
            </Grid>

            <!-- «ESCRÍBELE…»: la puerta de escribirle, que hasta el 2026-09-06 era la pastilla del
                 chat. Asoma tras segundo y medio de ratón quieto (ReglaDeLaLinea, promesa 167).

                 EL DISEÑO ES EL ORIGINAL DE LA RAMA 008, pedido así por el dueño tras probar dos
                 alternativas: cápsula de 30 px, cristal claro al 10 %, texto al 55 % de blanco.
                 Solo se le quitó una cosa de aquel original: el cartel que llevaba, que hoy no puede existir
                 (promesa 164). Lo que la línea hace se aprende pulsándola, no leyendo otro cartel.

                 EL AIRE SE ENSANCHÓ el mismo día (12 → 22 px), y en las DOS direcciones aunque solo
                 una se vea a la vez: GhostPista.Placement se invierte según el lado de la pantalla
                 (ver ApplyCaritaSide), y un margen asimétrico solo daba aire en uno de los dos casos
                 — pegada al lado sin margen, la línea habría nacido tocando la carita.

                 Es un Popup y no un hijo del StackPanel a propósito: así aparecer y desaparecer no
                 cambia el ancho de la ventana ni dispara el reanclaje de OnSizeChanged sobre una
                 carita que puede estar en pleno vuelo. -->
            <Popup x:Name="GhostPista" PlacementTarget="{Binding ElementName=CollapsedFace}"
                   Placement="Left" AllowsTransparency="True" StaysOpen="True">
                <Border x:Name="GhostBorde" Height="30" MinWidth="150" Cursor="IBeam"
                        CornerRadius="15" Background="#1AFFFFFF" BorderBrush="#2EFFFFFF"
                        BorderThickness="1" Padding="12,0" Margin="22,0,22,0"
                        MouseLeftButtonUp="OnGhostClic">
                    <TextBlock Text="Escríbele…" Foreground="#8CFFFFFF" FontSize="12"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Border>
            </Popup>
        </StackPanel>

        <!-- Estado NORMAL: menú extendido (arriba) + globo de conversación (izquierda) + barra (derecha).
             La ventana mide lo que mida el contenido (SizeToContent) y OnSizeChanged la mantiene
             anclada a la esquina inferior derecha: abrir el menú crece hacia arriba y a la izquierda. -->
        <!-- Dos filas y no un StackPanel: la barra es la fila Auto y el menú la fila «*». Así, cuando
             el contenido excede el MaxHeight de la ventana, quien cede es el MENÚ (que hace scroll),
             nunca la barra. Con un StackPanel el recorte se comía el último hijo — es decir, la
             interfaz permanente — y encima dependía de que yo calculara bien una altura a mano. -->
        <Grid x:Name="RootPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- MENÚ EXTENDIDO: se abre hacia arriba desde el activador. No es una ventana aparte:
                 es la continuación de la barra. Si no cabe, MenuScroll hace scroll interno — el
                 tope lo pone la fila, no una cuenta nuestra. -->
            <Border x:Name="MenuPanel" Grid.Row="0" VerticalAlignment="Bottom"
                    Width="292" HorizontalAlignment="Right" Visibility="Collapsed"
                    CornerRadius="20" Background="#F20F131C" BorderBrush="#38FFFFFF" BorderThickness="1"
                    Padding="12" Margin="0,0,0,8">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="MenuShift"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="48" ShadowDepth="12" Direction="270" Opacity="0.45" Color="#0B0F18"/>
                </Border.Effect>
                <ScrollViewer x:Name="MenuScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- ── Lo que se sacó de la barra ──────────────────────────────────────
                             La barra vive encima del trabajo de alguien y solo debería tener lo que
                             esa persona usa. Hablar y escribir ya están en la carita —las dos
                             pastillas—, y enseñar y silenciar son de quien desarrolla, no de quien
                             trabaja. Se conservan enteros, con su nombre y su manejador: mover algo
                             de sitio no es reescribirlo (2026-08-07). -->
                        <TextBlock Text="Acciones" Style="{StaticResource SectionLabel}"/>
                        <!-- TODO lo del producto como iconos, en una fila (2026-08-31): los botones
                             de ancho completo obligaban a leer una lista; una fila de iconos con
                             tooltip se recorre de un vistazo. El estado de cada toggle se dice con
                             el FONDO (acento = encendido), el patrón que TeachBtn ya tenía. -->
                        <UniformGrid Columns="5" Margin="0,4,0,10">
                            <!-- DEMO de punta a punta (2026-08-31): del Easy Access a los campos
                                 clínicos llenos, todo por batches del terreno. -->
                            <Button x:Name="DemoBtn" Content="🚀" Style="{StaticResource BarBtn}" Click="OnDemoPuntaAPunta"
                                    Margin="0"
                                    AutomationProperties.Name="Demo de punta a punta"/>
                            <!-- Enseñanza activa: graba pantalla+voz para que Ü aprenda a usar una
                                 app. En rojo mientras graba (SetTeachingUi). -->
                            <Button x:Name="TeachBtn" Content="🎓" Style="{StaticResource BarBtn}" Click="OnToggleTeach"
                                    Margin="0"
                                    AutomationProperties.Name="Enseñar"/>
                            <Button x:Name="WorkflowsBtn" Content="🧭" Style="{StaticResource BarBtn}" Click="OnOpenWorkflows"
                                    Margin="0"
                                    AutomationProperties.Name="Workflows"/>
                            <Button x:Name="VideosBtn" Content="🎞" Style="{StaticResource BarBtn}" Click="OnOpenVideos"
                                    Margin="0"
                                    AutomationProperties.Name="Videos"/>
                            <!-- Buscar actualizaciones AHORA. El sondeo automático mira cada 30 min y
                                 no dice nada mientras tanto —correcto para no molestar—, pero deja sin
                                 respuesta a quien acaba de enterarse de que hay versión nueva. Sin
                                 esto, la única forma de forzarlo era cerrar y volver a abrir. -->
                            <Button x:Name="CheckUpdateBtn" Content="🔄" Style="{StaticResource BarBtn}" Click="OnCheckUpdate"
                                    Margin="0"
                                    AutomationProperties.Name="Buscar actualizaciones"/>
                        </UniformGrid>

                        <!-- ── Ejecutar workflow: lo que el operador usa a diario ─────────────── -->
                        <DockPanel LastChildFill="False" Margin="0,0,0,3">
                            <TextBlock DockPanel.Dock="Left" Text="Ejecutar workflow"
                                       Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                            <Button x:Name="WorkflowViewToggle" DockPanel.Dock="Right" Content="☰" Width="26" Height="20"
                                    Click="OnToggleWorkflowView" Style="{StaticResource FlatBtn}" Background="#22FFFFFF"
                                    Foreground="#CCFFFFFF" FontSize="11"/>
                            <Button x:Name="WorkflowDeleteBtn" DockPanel.Dock="Right" Content="🗑" Width="26" Height="20"
                                    Margin="0,0,6,0" Click="OnDeleteWorkflow" Style="{StaticResource FlatBtn}"
                                    Background="#33FF3B30" Foreground="#EEFFFFFF" FontSize="11" IsEnabled="False"/>
                            <!-- Ponerle nombre (spec 007): el del cerebro llegaba como «Workflow sin
                                 descripción» tres de cuatro veces. Se abre solo al terminar de enseñar. -->
                            <Button x:Name="WorkflowRenameBtn" DockPanel.Dock="Right" Content="✏" Width="26" Height="20"
                                    Margin="0,0,6,0" Click="OnRenameWorkflow" Style="{StaticResource FlatBtn}"
                                    Background="#22FFFFFF" Foreground="#EEFFFFFF" FontSize="11" IsEnabled="False"/>
                        </DockPanel>

                        <!-- Vista CARRUSEL: flecha ◀, título centrado, flecha ▶ -->
                        <DockPanel x:Name="WorkflowCarousel" LastChildFill="True">
                            <Button x:Name="WorkflowPrev" DockPanel.Dock="Left" Content="◀" Width="30" Height="34"
                                    Click="OnWorkflowPrev" Style="{StaticResource FlatBtn}" Background="#22FFFFFF"
                                    Foreground="White" FontSize="12"/>
                            <Button x:Name="WorkflowNext" DockPanel.Dock="Right" Content="▶" Width="30" Height="34"
                                    Click="OnWorkflowNext" Style="{StaticResource FlatBtn}" Background="#22FFFFFF"
                                    Foreground="White" FontSize="12"/>
                            <Border Background="#14FFFFFF" CornerRadius="14" Margin="4,0" MinHeight="34">
                                <TextBlock x:Name="WorkflowPick" Text="Cargando workflows…" Foreground="#EEFFFFFF"
                                           FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                           VerticalAlignment="Center" Padding="6,4"/>
                            </Border>
                        </DockPanel>

                        <!-- Vista LISTA: oculta por defecto, se alterna con ☰ -->
                        <ListBox x:Name="WorkflowListBox" Height="128" Visibility="Collapsed"
                                 Background="#14FFFFFF" Foreground="White" BorderThickness="0"
                                 SelectionChanged="OnWorkflowListSelected"/>

                        <!-- El cuadro de nombre: aparece al terminar de enseñar (con el nombre derivado
                             seleccionado, para que escribir lo reemplace) y con ✏. Enter guarda, Escape
                             cancela, perder el foco también guarda. -->
                        <TextBox x:Name="WorkflowNameBox" Visibility="Collapsed" Height="28" Margin="0,6,0,0"
                                 VerticalContentAlignment="Center" Background="#22FFFFFF" Foreground="White"
                                 BorderThickness="0" Padding="8,0" FontSize="12"
                                 KeyDown="OnWorkflowNameKey" LostFocus="OnWorkflowNameLostFocus"/>

                        <Button x:Name="RunWorkflowBtn" Content="▶ Ejecutar ahora" Height="34" Margin="0,8,0,0"
                                Click="OnRunWorkflowDirect" Style="{StaticResource MenuBtn}" Background="#2FB457"
                                HorizontalContentAlignment="Center" FontWeight="SemiBold" FontSize="12" IsEnabled="False"/>

                        <Border Style="{StaticResource Sep}"/>

                        <!-- ── Backend: herramientas de desarrollo, TODAS a la vista. El desplegable
                             que las escondía murió en la limpieza del panel (2026-08-31): abrirlo
                             era un clic que no compraba nada — quien llega hasta aquí ya está
                             mirando el panel entero, y un estado oculto es un estado que se olvida.
                             La señal de conexión con Graph vive en el propio texto de estado. ──── -->
                        <StackPanel x:Name="BackendZone">
                            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                <!-- La misma señal de salud que tenía la cabecera plegada: qué pasó la
                                     última vez que se habló con Graph (colores en GraphHealthText). -->
                                <Ellipse x:Name="BackendDot" DockPanel.Dock="Right" Width="7" Height="7"
                                         Fill="#8A8A8E" VerticalAlignment="Center"/>
                                <TextBlock Text="Backend" Style="{StaticResource SectionLabel}"/>
                            </DockPanel>

                            <StackPanel x:Name="BackendBody" Margin="0,0,0,0">
                                <!-- El backend ya no se configura a mano: la URL tiene default sano y la
                                     API key llega sola (key embebida en el build de distribución, o env
                                     GRAPH_API_KEY en dev). Esto es solo un estado de diagnóstico. Ver
                                     GraphConfig.Load y el doc "Distribución conectada". -->
                                <TextBlock x:Name="BackendStatus" Foreground="#88FFFFFF" FontSize="10"
                                           TextWrapping="Wrap" Margin="0,0,0,2"/>

                                <!-- Qué atajo global quedó ACTIVO. Se enseña porque puede no ser el
                                     preferido: si otra aplicación ya tenía la combinación, se registra
                                     la de respaldo, y anunciar la que no es sería peor que no decir
                                     nada. Lo rellena OnSourceInitialized. -->
                                <TextBlock x:Name="HotkeyStatus" Foreground="#88FFFFFF" FontSize="10"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>

                                <!-- Las herramientas, como iconos (misma regla que Acciones): el estado
                                     de cada toggle lo dice el fondo, y el tooltip cuenta el detalle.
                                     🔍 inspector (recuadros estilo TalkBack, ver UiInspector) ·
                                     📍 el location bar de Windows (mismo formato que source_url) ·
                                     🧠 los recuerdos de esta pantalla de golpe (ver MostrarRecuerdos) ·
                                     🎬 qué se hace con el video al enseñar · 📜 el registro. -->
                                <UniformGrid Columns="5" Margin="0,8,0,0">
                                    <Button x:Name="InspectorBtn" Content="🔍" Style="{StaticResource BarBtn}"
                                            Click="OnToggleInspector" Margin="0"
                                            AutomationProperties.Name="Inspector de elementos"/>
                                    <Button x:Name="LocatorBtn" Content="📍" Style="{StaticResource BarBtn}"
                                            Click="OnToggleLocator" Margin="0"
                                            AutomationProperties.Name="ID de superficie"/>
                                    <Button x:Name="RecuerdosBtn" Content="🧠" Style="{StaticResource BarBtn}"
                                            Click="OnVerRecuerdos" Margin="0"
                                            AutomationProperties.Name="Ver recuerdos de aquí"/>
                                    <Button x:Name="LogsBtn" Content="📜" Style="{StaticResource BarBtn}"
                                            Click="OnOpenLogs" Margin="0"
                                            AutomationProperties.Name="Logs"/>
                                </UniformGrid>

                                <!-- Para soporte: saber qué versión tiene el cliente delante sin pedir nada. -->
                                <TextBlock x:Name="VersionText" Text="" Foreground="#66FFFFFF" FontSize="10"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Fila inferior: el globo de conversación a la izquierda, la barra a la derecha. -->
            <DockPanel x:Name="BarRow" Grid.Row="1" HorizontalAlignment="Right" LastChildFill="False">

                <!-- GLOBO DE CONVERSACIÓN: estado + narración + entrada de texto. Aparece solo cuando
                     hay algo que decir (narración, una pregunta, una ejecución en curso) o cuando el
                     usuario lo abre con 💬. Se cierra con ✕ o Esc; lo que muestre sigue actualizándose
                     aunque esté cerrado (Status/Bubble viven aquí). -->
                <Border x:Name="TalkPanel" DockPanel.Dock="Left" Width="252" Visibility="Collapsed"
                        VerticalAlignment="Bottom" CornerRadius="20" Background="#F20F131C"
                        BorderBrush="#38FFFFFF" BorderThickness="1" Padding="14" Margin="0,0,8,0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="TalkShift"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="48" ShadowDepth="12" Direction="270" Opacity="0.45" Color="#0B0F18"/>
                    </Border.Effect>
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Button x:Name="TalkCloseBtn" DockPanel.Dock="Right" Content="✕" Width="22" Height="22"
                                    Style="{StaticResource FlatBtn}" Background="#22FFFFFF" FontSize="10"
                                    Margin="6,0,0,0" VerticalAlignment="Top"
                                    AutomationProperties.Name="Cerrar la conversación"/>
                            <TextBlock x:Name="Status" Text="Ü listo" Foreground="#EEFFFFFF" FontSize="12.5"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Globo de narración: crece con el texto (la ventana se expande hacia arriba) y,
                             si el texto excede el máximo, hace scroll en vez de cortarse. -->
                        <ScrollViewer MaxHeight="320" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="Bubble" Text="" Foreground="#CCFFFFFF" FontSize="12"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>

                        <!-- Entrada de texto: también resuelve las preguntas del asistente (AskAsync
                             abre este globo y enfoca la caja). El micrófono vive en la barra. -->
                        <TextBox x:Name="Input" Height="30" Margin="0,10,0,0" VerticalContentAlignment="Center"
                                 Background="#22FFFFFF" Foreground="White" BorderThickness="0" Padding="8,0"
                                 KeyDown="OnInputKey"/>
                    </StackPanel>
                </Border>

                <!-- LA BARRA: vertical, estrecha, siempre disponible. Arrastrable por cualquier zona
                     libre (y por la carita). De arriba a abajo: la zona contextual (⬇ ⏹ 🔄, que
                     aparecen y desaparecen), el activador del menú, las acciones fijas y, abajo del
                     todo, la carita.

                     Ese orden no es estético, es aritmética. El borde INFERIOR de la barra está
                     clavado (la ventana se ancla por la esquina), así que cuando la barra crece, crece
                     hacia arriba: un botón que aparece empuja 44 px hacia arriba a todo lo que tenga
                     ENCIMA y no mueve nada de lo que tenga debajo. Con los contextuales en medio, el
                     activador saltaba justo cuando el usuario iba hacia él. Poniéndolos arriba del
                     todo no queda nadie por encima y el desplazamiento es cero para todos.

                     Lo demás: el activador va sobre las acciones porque el menú nace justo encima, y
                     la carita va abajo porque ahí vive la burbuja cuando se colapsa — así no salta de
                     sitio al alternar entre los dos estados. -->
                <!-- EL PANEL. Estadio blanco sobre una PLACA que echa la sombra.
                     La placa es un borde gemelo sin un solo hijo, y no es un capricho: un Effect es
                     un shader, y WPF rasteriza a una textura intermedia todo el subarbol que cuelga
                     del elemento que lo lleva. Dentro de esa textura el texto pierde ClearType y se
                     ve lavado. Es la regla de Estudio.Elevar, dicha aqui en XAML porque el arbol lo
                     declara el XAML.

                     COLORES, RADIOS Y SOMBRAS NO ESTAN AQUI: los pone VestirElPanelConElEstudio()
                     desde Estudio. Tenerlos en el XAML seria tener la paleta en dos sitios, que es
                     exactamente como se desincronizan (aprendizaje n.16). -->
                <Grid x:Name="BarShell" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border x:Name="BarPlaca"/>
                    <!-- El relleno vertical es GRANDE porque el panel es un estadio: sus puntas son
                         semicircunferencias de radio ancho/2, y cualquier cosa colocada ahi queda
                         pellizcada por la curva. 30 px dejan las dos puntas vacias, que es como se
                         ve en el diseno que dio el dueno. -->
                    <Border x:Name="BarPanel" BorderThickness="1" Padding="12,26" Width="150">
                    <StackPanel>

                        <!-- LA CARITA, ARRIBA, Y SOLO CUANDO ESTA GUARDADA AQUI (peticion del
                             2026-09-05). Antes vivia permanente en la barra y se veian dos caras a
                             la vez: una flotando y otra dentro del panel, sin que nada dijera cual
                             era cual. Ahora esta silla es literal — hay cara si la carita esta
                             dentro, y no hay nada si esta fuera. Ver CaritaGuardada. -->
                        <ui:FaceControl x:Name="Face" Width="66" Height="66" Cursor="Hand"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center" Margin="0,4,0,16"/>

                        <!-- LOS TRES. Live va separado y algo mas estrecho, como en el diseño: no
                             es del mismo grupo que los otros dos — Learn y Work son lo que Ü hace
                             POR TI en la pantalla; Live abre la consulta clinica, que es otra cosa. -->
                        <Button x:Name="LearnBtn" Content="Learn" Height="38" Click="OnToggleTeach"
                                AutomationProperties.Name="Enseñar"/>
                        <!-- WORK NO HACE NADA TODAVÍA, y está dicho aquí y en su tooltip a
                             propósito. El dueño lo pidió sin acción el 2026-09-05 para decidir más
                             adelante qué cuelga de él. Un botón mudo que aparenta funcionar es
                             justo lo que mató a los tres modos que vivieron en esta barra
                             (2026-08-31): «un botón que no hace nada enseña a ignorar los
                             botones». Si esto sigue así dentro de unos días, se quita. -->
                        <Button x:Name="WorkBtn" Content="Work" Height="38" Margin="0,8,0,0"
                                AutomationProperties.Name="Trabajar (sin función todavía)"/>

                    <StackPanel x:Name="ZonaSecundaria" Margin="0,12,0,0">
                        <!-- ZONA CONTEXTUAL: lo que solo existe a ratos. Va envuelta para que el
                             separador se colapse con ella (si no, queda una raya flotando sobre nada)
                             y para que su visibilidad se decida en UN sitio: UpdateContextZone(). -->
                        <StackPanel x:Name="ContextZone" Visibility="Collapsed">
                            <!-- Pastilla de actualización: oculta salvo que ya haya una versión descargada
                                 y lista. Si el usuario la ignora, se aplica sola al cerrar (ApplyOnExit). -->
                            <Button x:Name="UpdateBtn" Content="⬇" Style="{StaticResource BarBtn}"
                                    Margin="0" Background="#553B82F6" Visibility="Collapsed" Click="OnApplyUpdate"
                                    AutomationProperties.Name="Aplicar la actualización"/>

                            <!-- Solo visible mientras ejecuta algo: detener es detener, también la voz. -->
                            <Button x:Name="StopBtn" Content="⏹" Style="{StaticResource BarBtn}"
                                    Background="#55FF3B30" Visibility="Collapsed" Click="OnStop"
                                    AutomationProperties.Name="Detener"/>

                            <!-- Descartar lo grabado y volver a empezar. Sigue inerte: el reinicio en
                                 caliente aún no existe en la enseñanza unificada (ver OnRestartTeach y
                                 el follow-up WorkflowTeachSession.RestartAsync). Se conserva a
                                 propósito, no por olvido. -->
                            <Button x:Name="RestartTeachBtn" Content="🔄" Style="{StaticResource BarBtn}"
                                    Visibility="Collapsed" Click="OnRestartTeach"
                                    AutomationProperties.Name="Rehacer la enseñanza"/>

                            <!-- COMPROBAR EL APRENDIZAJE, y es obligatorio antes de poder usar una
                                 tarea (decisión del dueño, 2026-09-03): Ü recorre lo que le acabas
                                 de enseñar, narrándolo, y cuelga de cada elemento lo que dijiste de
                                 él. Se detiene antes de cualquier puerta que no se pueda deshacer. -->
                            <Button x:Name="ComprobarBtn" Content="🧭" Style="{StaticResource BarBtn}"
                                    Click="OnComprobarAprendizaje"
                                    AutomationProperties.Name="Comprobar el aprendizaje"/>

                            <Border x:Name="SepContexto" Height="1" Margin="6,8,6,0"/>
                        </StackPanel>

                        <!-- ACTIVADOR del menú extendido: hover lo abre (hacia arriba, justo encima),
                             clic lo fija, Esc lo cierra. El chevron apunta a donde va a nacer el menú;
                             girado significa «ciérralo». Ver UpdateChevron(). -->
                        <Button x:Name="MenuActivator" Height="26" Margin="0,4,0,0" Style="{StaticResource BarBtn}"
                                Width="38" FontSize="11" Background="#00FFFFFF"
                                AutomationProperties.Name="Más herramientas">
                            <Path x:Name="ActivatorChevron" Data="M 0 5 L 6 0 L 12 5"
                                  Stroke="#CCFFFFFF" StrokeThickness="1.8" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="ActivatorRot" Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Button>

                        <Border x:Name="SepBarra" Height="1" Margin="6,6,6,0"/>

                        <!-- Los tres modos de Ü (autónomo, proactividad, aprendizaje) vivieron aquí
                             como placeholders sin cablear; murieron en la limpieza de la tira
                             (2026-08-31): un botón que no hace nada enseña a ignorar los botones.

                             EL COLLAR OMI. En la tira y no sólo en el panel grande porque es donde
                             el usuario mira: la fila de acciones vive dos pantallas más adentro
                             (2026-08-13, lo dijo al no encontrarlo). Desde la limpieza es la ÚNICA
                             puerta al collar: el 📿 del panel era su copia.

                             Dibujado con trazo de 1,5 y extremos redondeados —el mismo lápiz que la
                             carita— y no con un emoji: un emoji lo pinta la fuente del sistema, trae
                             su propio color y su propio peso, y rompe la tira (2026-08-07). -->
                        <Button x:Name="CollarModoBtn" Style="{StaticResource BarBtn}" Click="OnCollar"
                                AutomationProperties.Name="Análisis clínico">
                            <!-- Un collar: el cordón cayendo y la pieza colgando. -->
                            <Canvas Width="20" Height="20">
                                <Path Stroke="#E8FFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 5,4 C 5,11.2 15,11.2 15,4"/>
                                <Ellipse x:Name="CollarPunto" Canvas.Left="7.6" Canvas.Top="11.4"
                                         Width="4.8" Height="4.8" Fill="#E8FFFFFF"/>
                            </Canvas>
                        </Button>

                    </StackPanel>
                    </StackPanel>
                    </Border>
                </Grid>

                <!-- LA FRASE CORTA: acompaña a la carita para que el estado no dependa de aprenderse
                     los gestos. Va FUERA de la barra, a su izquierda, y por eso no rompe los 60 DIP de
                     ancho: la ventana está anclada por su borde derecho, así que crecer hacia la
                     izquierda no mueve absolutamente nada (la misma aritmética que hace que los
                     contextuales no empujen al activador).

                     Declarada DESPUÉS de BarPanel a propósito: en un DockPanel los hijos con
                     Dock=Right se apilan de derecha a izquierda en orden de declaración.

                     No es un eco del globo: cuando el globo está abierto, esta píldora se esconde
                     (allí ya está el texto largo). Ver UpdateChip. -->
                <Border x:Name="StatusChip" DockPanel.Dock="Right" Visibility="Collapsed"
                        VerticalAlignment="Bottom" Margin="0,0,8,14"
                        CornerRadius="10" Background="#F20F131C" BorderBrush="#38FFFFFF" BorderThickness="1"
                        Padding="10,5" MaxWidth="170">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ChipShift"/>
                    </Border.RenderTransform>
                    <TextBlock x:Name="StatusChipText" Foreground="#EEFFFFFF" FontSize="11"
                               TextTrimming="CharacterEllipsis"/>
                </Border>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
