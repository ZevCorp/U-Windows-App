         «no se», dice «culpable» (aprendizaje n.17). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>U.WindowsClient</RootNamespace>
    <AssemblyName>U</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Ãcono del .exe (y, por tanto, de los accesos directos): la MISMA carita/logo de la app Android
         (adaptive icon portado a .ico multi-resoluciÃ³n). -->
    <ApplicationIcon>U.ico</ApplicationIcon>
    <!-- Velopack (auto-update) exige que VelopackApp.Build().Run() sea lo PRIMERO del proceso, antes de
         levantar WPF: cuando el updater relanza el .exe con sus hooks, el proceso debe atenderlos y
         salir sin abrir ventana. WPF genera su propio Main a partir de App.xaml, asÃ­ que se apunta el
         StartupObject al Main manual de App.xaml.cs y App.xaml pasa de ApplicationDefinition a Page
         (abajo) para que no se generen dos entry points. -->
    <StartupObject>U.WindowsClient.App</StartupObject>
    <!-- ScreenRecorderLib requiere plataforma especÃ­fica, no AnyCPU. Platform es propiedad MSBuild
         (distinta de RuntimeIdentifier de .NET 5+). -->
    <Platform>x64</Platform>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ver StartupObject arriba: App.xaml se compila como Page para que el SDK no genere un Main que
         competirÃ­a con el nuestro. InitializeComponent() sigue existiendo y StartupUri sigue funcionando. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sonidos de la carita (los MISMOS WAV de la app Android): tick al hacer clic, carrillÃ³n al
         activar el micrÃ³fono con doble clic. Van embebidos como recurso WPF y se cargan por stream. -->
    <Resource Include="assets\tick.wav" />
    <Resource Include="assets\mic_chime.wav" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI Automation (UIA): lectura del Ã¡rbol de UI de cualquier app de Windows.
         Vienen con Microsoft.WindowsDesktop.App (UseWPF), como referencias del framework. -->
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
  </ItemGroup>

  <ItemGroup>
    <!-- Workflows de Graph (grabar y ejecutar sobre SAP GUI / UIA). MÃ³dulo AISLADO: vive en su propio
         proyecto, habla solo con el backend Graph y no conoce el cerebro de este cliente. Se referencia
         aquÃ­ para que viaje dentro de U.exe, no porque el asistente dependa de Ã©l. -->
    <ProjectReference Include="..\windows-graph\GraphWorkflows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- TTS/STT integrados de Windows (paquete NuGet en .NET moderno). -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- Opus en C# PURO, sin DLL nativa: el collar Omi entrega Opus y hay que decodificarlo. Se
