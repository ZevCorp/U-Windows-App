    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <!-- Captura de pantalla (GDI) para computer-use. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.7" />
    <!-- 8.0.5 y no 8.0.4: la 8.0.4 arrastra GHSA-8g4q-xg66-9fp4 (severidad alta) y esto se instala en
         la mÃ¡quina de un cliente. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <!-- GrabaciÃ³n de pantalla + micrÃ³fono â†’ mp4 H.264+AAC. ScreenRecorderLib: MIT license,
         mantenida activamente (v6.6.0, nov 2025). Produce mp4 con fast-start (streamable),
         soporta mezcla de audio de entrada (mic) + salida (sistema). -->
    <PackageReference Include="ScreenRecorderLib" Version="6.6.0" />
    <!-- Auto-update (ver src/Update/Updater.cs y RELEASING-WINDOWS.md). Velopack empaqueta la CARPETA
         publicada tal cual, asÃ­ que convive con ScreenRecorderLib (ensamblado mixto C++/CLI) sin
         necesitar PublishSingleFile, que es justo lo que este proyecto no puede usar. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- EL NÚCLEO. La dependencia va en UNA dirección y no se invierte nunca: el cliente conoce al
