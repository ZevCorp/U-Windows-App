  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041.0 y no «net8.0-windows» a secas: las proyecciones de WinRT
         (Windows.Devices.Bluetooth) solo existen con la version de Windows en el TFM, y sin ellas no
