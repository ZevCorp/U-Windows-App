         probar sin levantar la app entera — y se rompió en silencio (2026-08-12). -->
    <ProjectReference Include="..\mapeador\Pulso\Pulso.csproj" />

    <!-- LO QUE SE SABE DEL COLLAR sin saber de Bluetooth: códec, cabecera, reposición del silencio.
         Fuera del cliente por la misma razón que los dos de arriba — un net8.0 puro se juzga en la
         nube en cada PR; esto, con WinRT dentro, no. Ver voz\Contrato y la spec 001. -->
    <ProjectReference Include="..\voz\Omi\Omi.csproj" />
  </ItemGroup>

</Project>


