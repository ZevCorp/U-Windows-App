<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cliente Windows del asistente Ãœ. Es un FRONTEND TONTO: lee el Ã¡rbol de UI con UIA, captura la
    pantalla, ejecuta acciones (ratÃ³n/teclado/sistema) y muestra la carita flotante. NO contiene NADA
