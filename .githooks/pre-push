#!/usr/bin/env bash
# EL PORTERO. Lo único de todo el flujo que no se puede olvidar.
#
# Por qué existe (2026-08-21): el repo tenía 6 archivos de reglas y 7 skills describiendo cómo se
# trabaja, y en .git/hooks solo había post-checkout y post-commit. O sea: todo el proceso eran
# PETICIONES, y ninguna garantía. El usuario lo dijo con sus palabras — «demasiada burocracia pero
# no siento que me esté verificando lo que necesito» — y tenía razón: era papeleo sin portero.
#
# La regla es una: lo que TIENE que pasar va aquí; los .md explican el porqué, que es lo que un
# hook no sabe hacer. Ver docs/como-trabajamos.md.
#
# Está en .githooks/ y no en .git/hooks/ a propósito: .git/ no se versiona, así que un hook ahí
# dentro solo protege a quien se acordó de ponerlo. Se activa con UNA línea, dicha en el doc:
#     git config core.hooksPath .githooks
#
# Tarda ~60 s. Si algún día tarda más, se recorta el hook, no la paciencia: un portero que cansa
# es un portero que alguien acaba saltándose con --no-verify.

set -u

rojo()  { printf '\033[31m%s\033[0m\n' "$*"; }
verde() { printf '\033[32m%s\033[0m\n' "$*"; }
gris()  { printf '\033[90m%s\033[0m\n' "$*"; }

raiz="$(git rev-parse --show-toplevel)"
cd "$raiz" || exit 1

rama="$(git rev-parse --abbrev-ref HEAD)"
fallos=0

echo
echo "  ── el portero ──────────────────────────────────"
echo

# ── 0. a main no se empuja directo ────────────────────────────────────────────────────────────
# main es la rama estable y solo entra por pull request. Sin esto, «trabajar organizado» dura
# exactamente hasta el primer día con prisa.
if [ "$rama" = "main" ]; then
  rojo "  ✘  a main no se empuja directo"
  echo "     Haz tu rama, empújala, y abre el PR:"
  echo "         git switch -c feat/lo-que-sea"
  echo
  exit 1
fi

# ── 1. compila ────────────────────────────────────────────────────────────────────────────────
gris "  … compilando"
if dotnet build windows-client/WindowsClient.csproj -c Release -v quiet --nologo > /tmp/u-build.log 2>&1; then
  verde "  ✔  compila"
else
  rojo  "  ✘  NO compila"
  grep -E "error [A-Z]+[0-9]+" /tmp/u-build.log | head -5 | sed 's/^/     /'
  fallos=$((fallos+1))
fi

# ── 2. los contratos ──────────────────────────────────────────────────────────────────────────
# No son «tests» genéricos: son las promesas que el sistema dice cumplir. Rojo aquí significa que
# algo que prometíamos dejó de ser cierto, y eso no entra en main aunque compile.
contrato() {
  local nombre="$1" script="$2"
  [ -f "$script" ] || { gris "  ·  $nombre: no está $script, se salta"; return; }
  gris "  … $nombre"
  local salida
  salida="$(powershell -NoProfile -ExecutionPolicy Bypass -File "$script" 2>&1)"
  if printf '%s' "$salida" | grep -qE "INTACTO|ÍNTEGRA|ÍNTEGRO"; then
    verde "  ✔  $nombre"
  else
    rojo  "  ✘  $nombre ROTO"
    printf '%s' "$salida" | grep -E "✘|ROTO|incumplid" | head -5 | sed 's/^/     /'
    fallos=$((fallos+1))
  fi
}

contrato "contrato del grafo" "scripts/contrato-del-grafo.ps1"
contrato "contrato de la voz" "scripts/contrato-de-la-voz.ps1"

# ── 3. la funcionalidad trae su propio test ───────────────────────────────────────────────────
# Es la promesa que hace crecer la carpeta de tests SOLA, en vez de por disciplina. Sin esto, cada
# rama añade código sin cobertura y el 7% de hoy nunca sube.
#
# Se exime lo que por definición no añade comportamiento: chore/, docs/ y refactor/. Y se dice cuál
# es la salida, para que nadie tenga que adivinarla ni buscar el --no-verify.
case "$rama" in
  chore/*|docs/*|refactor/*|hotfix/*)
    gris "  ·  test propio: no se exige en «${rama%%/*}/»"
    ;;
  *)
    base="$(git merge-base HEAD origin/main 2>/dev/null || echo main)"
    tocado_codigo="$(git diff --name-only "$base"...HEAD -- 'windows-client/**/*.cs' 'nucleo/**/*.cs' 'mapeador/**/*.cs' | wc -l)"
    tocado_test="$(git diff --name-only "$base"...HEAD -- '**/Contrato.cs' 'tests/**' | wc -l)"
    if [ "$tocado_codigo" -gt 0 ] && [ "$tocado_test" -eq 0 ]; then
      rojo "  ✘  esta rama cambia código y no añade ninguna promesa"
      echo "     $tocado_codigo archivo(s) de código, 0 de contrato."
      echo "     Añade lo que esta funcionalidad promete en tests/ContratoDelGrafo/Contrato.cs"
      echo "     —o renómbrala a chore/ o refactor/ si de verdad no cambia comportamiento."
      fallos=$((fallos+1))
    else
      verde "  ✔  trae su propio test"
    fi
    ;;
esac

echo
if [ "$fallos" -gt 0 ]; then
  rojo "  no entra: $fallos comprobación(es) en rojo"
  echo
  gris "  Si crees que el portero se equivoca, la conversación es sobre la promesa,"
  gris "  no sobre saltarse el hook. --no-verify existe y deja rastro en nadie."
  echo
  exit 1
fi

verde "  todo en verde — adelante"
echo
exit 0
