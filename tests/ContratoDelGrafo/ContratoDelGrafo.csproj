<Project Sdk="Microsoft.NET.Sdk">
  <!-- EL CONTRATO DEL GRAFO. No es «un proyecto de tests»: es la definición ejecutable de lo que
       el núcleo de navegación promete, escrita el día que alcanzó estabilidad (2026-08-08).

       Referencia los BINARIOS compilados y no el proyecto, a propósito: el contrato juzga lo que
       de verdad se va a ejecutar, y compilar aparte evita pelearse con la app estable que tiene
       sus DLL bloqueadas. La ruta la inyecta scripts/contrato-del-grafo.ps1, que es la única
       forma prevista de correr esto. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AssemblyName>contrato-del-grafo</AssemblyName>
    <UBin Condition="'$(UBin)' == ''">C:\U-dev2\bin</UBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="U"><HintPath>$(UBin)\U.dll</HintPath></Reference>
    <Reference Include="U.Graph"><HintPath>$(UBin)\U.Graph.dll</HintPath></Reference>
    <!-- El núcleo. Entra el 2026-08-22, cuando las cinco capacidades que la voz usa de verdad
         empiezan a mudarse aquí: sin esto el contrato solo podría juzgar el mapa viejo, que es
         justo lo que estamos dejando atrás. -->
    <Reference Include="Nucleo.Grafo"><HintPath>$(UBin)\Nucleo.Grafo.dll</HintPath></Reference>
    <!-- El mapeador. Entra con «abrir» (2026-08-23): quién decide CÓMO se llega a un sitio
         —programa, pestaña o SAP— ya vive ahí y tiene sus propias promesas. Decidirlo otra vez
         aquí habría creado una segunda opinión sobre el mismo hecho. -->
    <Reference Include="Mapeador.Pulso"><HintPath>$(UBin)\Mapeador.Pulso.dll</HintPath></Reference>
    <!-- El catálogo neutro de herramientas (Utensilio). Entra con el servidor MCP (2026-08-24):
         las promesas 60-62 construyen el catálogo con estos tipos. -->
    <Reference Include="Voz.Realtime"><HintPath>$(UBin)\Voz.Realtime.dll</HintPath></Reference>
    <!-- El collar: la promesa 146 juzga de dónde entra el audio para TODA la app. -->
    <Reference Include="Omi"><HintPath>$(UBin)\Omi.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- LOS VECTORES DE LA WEB (spec 055): lo que Miracle Notes web contesta, congelado por
         bronce/generar-desde-la-web.mts. Embebidos y no leídos de disco: el contrato se corre
         desde carpetas distintas (el CI, la de cada dev) y una ruta relativa que no se encuentra
         convertiría 8 promesas en «no pude ejecutarla» (aprendizaje nº17). -->
    <EmbeddedResource Include="bronce\miracle-notes-web.json" LogicalName="miracle-notes-web.json" />
  </ItemGroup>
</Project>
