<Project Sdk="Microsoft.NET.Sdk">
  <!-- EL CONTRATO DE Ü DESDE CERO (spec 052, promesas 430-441). Juzga el núcleo sin pantalla y sin red.
       Pide las piezas POR NOMBRE, con reflexión: una pieza que todavía no existe es PENDIENTE, no un
       error de compilación — el juez tiene que poder decir «no está» sin dejar de juzgar lo demás. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>contrato-u</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nucleo\Nucleo.csproj" />
  </ItemGroup>
</Project>
